---
---

<div style="border:1px solid oklch(87% 0.014 75);padding:clamp(20px, 5vw, 40px);background:oklch(97% 0.01 75);">
  <div id="form-enviado" style="display:none;padding:24px;background:oklch(94% 0.014 75);border:1px solid oklch(58% 0.09 75);">
    <p style="margin:0;font-size:16px;">Gracias por tu interés en Patio Riquelme. Recibimos tu solicitud y te contactaremos pronto.</p>
  </div>
  <form id="contacto-page-form" style="display:flex;flex-direction:column;gap:18px;">
    <div style="display:grid;grid-template-columns:var(--cols-form);gap:18px;">
      <input type="text" required placeholder="Nombre" style="padding:14px 16px;border:1px solid oklch(83% 0.014 75);font-size:15px;font-family:'Work Sans',sans-serif;background:oklch(97% 0.01 75);" />
      <input type="tel" placeholder="Teléfono" style="padding:14px 16px;border:1px solid oklch(83% 0.014 75);font-size:15px;font-family:'Work Sans',sans-serif;background:oklch(97% 0.01 75);" />
    </div>
    <input type="email" required placeholder="Email" style="padding:14px 16px;border:1px solid oklch(83% 0.014 75);font-size:15px;font-family:'Work Sans',sans-serif;background:oklch(97% 0.01 75);" />
    <select style="padding:14px 16px;border:1px solid oklch(83% 0.014 75);font-size:15px;font-family:'Work Sans',sans-serif;background:oklch(97% 0.01 75);color:oklch(25% 0.035 75);">
      <option>Studio</option>
      <option>1 Dormitorio</option>
      <option>Aún no estoy seguro</option>
    </select>
    <textarea placeholder="Mensaje (opcional)" rows="4" style="padding:14px 16px;border:1px solid oklch(83% 0.014 75);font-size:15px;font-family:'Work Sans',sans-serif;background:oklch(97% 0.01 75);resize:vertical;"></textarea>
    <label style="display:flex;align-items:center;gap:10px;font-size:14px;color:oklch(38% 0.03 75);"><input type="checkbox" /> Quiero agendar una visita presencial</label>
    <label style="display:flex;align-items:center;gap:10px;font-size:14px;color:oklch(38% 0.03 75);"><input type="checkbox" /> Enviarme el brochure en PDF</label>
    <button type="submit" style="background:oklch(58% 0.09 75);color:oklch(98% 0.006 75);border:none;padding:16px 28px;font-size:15px;font-weight:500;cursor:pointer;margin-top:8px;">Enviar solicitud</button>
  </form>
</div>

<script>
  const form = document.getElementById('contacto-page-form');
  const enviado = document.getElementById('form-enviado');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    (form as HTMLElement).style.display = 'none';
    (enviado as HTMLElement).style.display = 'block';
  });
</script>
