---
import { FORMSPREE_ENDPOINT } from '../lib/config';
---

<div style="border:1px solid oklch(87% 0.014 75);padding:clamp(20px, 5vw, 40px);background:oklch(97% 0.01 75);">
  <div id="form-enviado" style="display:none;padding:24px;background:oklch(94% 0.014 75);border:1px solid oklch(58% 0.09 75);">
    <p style="margin:0;font-size:16px;">Gracias por tu interés en Patio Riquelme. Recibimos tu solicitud y te contactaremos pronto.</p>
  </div>
  <div id="form-error" style="display:none;margin-bottom:18px;padding:16px;background:oklch(94% 0.014 75);border:1px solid oklch(55% 0.15 30);">
    <p style="margin:0;font-size:14px;">Hubo un problema al enviar tu solicitud. Intenta de nuevo o escríbenos directo a <a href="mailto:contacto@patioriquelme.cl" style="color:oklch(25% 0.035 75);">contacto@patioriquelme.cl</a>.</p>
  </div>
  <form id="contacto-page-form" action={FORMSPREE_ENDPOINT} method="POST" style="display:flex;flex-direction:column;gap:18px;">
    <input type="hidden" name="_subject" value="Nueva consulta — Patio Riquelme (Contacto)" />
    <div style="display:grid;grid-template-columns:var(--cols-form);gap:18px;">
      <input type="text" name="nombre" required placeholder="Nombre" style="padding:14px 16px;border:1px solid oklch(83% 0.014 75);font-size:15px;font-family:'Work Sans',sans-serif;background:oklch(97% 0.01 75);" />
      <input type="tel" name="telefono" placeholder="Teléfono" style="padding:14px 16px;border:1px solid oklch(83% 0.014 75);font-size:15px;font-family:'Work Sans',sans-serif;background:oklch(97% 0.01 75);" />
    </div>
    <input type="email" name="email" required placeholder="Email" style="padding:14px 16px;border:1px solid oklch(83% 0.014 75);font-size:15px;font-family:'Work Sans',sans-serif;background:oklch(97% 0.01 75);" />
    <select id="tipologia-select" name="tipologia" style="padding:14px 16px;border:1px solid oklch(83% 0.014 75);font-size:15px;font-family:'Work Sans',sans-serif;background:oklch(97% 0.01 75);color:oklch(25% 0.035 75);">
      <option value="E">E · Estudio</option>
      <option value="1D">1D · 1 Dormitorio</option>
      <option value="Duplex">Duplex 1D 1/2</option>
      <option value="Local">Local comercial</option>
      <option value="">Aún no estoy seguro</option>
    </select>
    <textarea name="mensaje" placeholder="Mensaje (opcional)" rows="4" style="padding:14px 16px;border:1px solid oklch(83% 0.014 75);font-size:15px;font-family:'Work Sans',sans-serif;background:oklch(97% 0.01 75);resize:vertical;"></textarea>
    <label style="display:flex;align-items:center;gap:10px;font-size:14px;color:oklch(38% 0.03 75);"><input type="checkbox" name="visita" /> Quiero agendar una visita presencial</label>
    <label style="display:flex;align-items:center;gap:10px;font-size:14px;color:oklch(38% 0.03 75);"><input type="checkbox" name="brochure" /> Enviarme el brochure en PDF</label>
    <button type="submit" style="background:oklch(58% 0.09 75);color:oklch(98% 0.006 75);border:none;padding:16px 28px;font-size:15px;font-weight:500;cursor:pointer;margin-top:8px;">Enviar solicitud</button>
  </form>
</div>

<script>
  const params = new URLSearchParams(location.search);
  const tipologia = params.get('tipologia');
  const select = document.getElementById('tipologia-select') as HTMLSelectElement | null;
  if (select && tipologia && [...select.options].some((o) => o.value === tipologia)) {
    select.value = tipologia;
  }

  const form = document.getElementById('contacto-page-form') as HTMLFormElement | null;
  const enviado = document.getElementById('form-enviado');
  const error = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (error) error.style.display = 'none';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.style.display = 'none';
        if (enviado) enviado.style.display = 'block';
      } else if (error) {
        error.style.display = 'block';
      }
    } catch {
      if (error) error.style.display = 'block';
    }
  });
</script>
