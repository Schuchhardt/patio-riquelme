---
import { summaries, formatM2, formatUF, formatPisos } from '../lib/unidades';

const options = [
  { value: 'E', label: 'E · Estudio' },
  { value: '1D', label: '1D · 1 Dormitorio' },
  { value: 'Duplex', label: 'Duplex' },
  { value: 'L', label: 'Locales Comerciales' },
];

// Todo se deriva del CSV: no hay textos de pisos ni precios escritos a mano.
const data = Object.fromEntries(
  options.map(({ value }) => [
    value,
    {
      m2: formatM2(summaries[value]),
      count: summaries[value].count,
      pisos: formatPisos(summaries[value].pisos),
      desde: formatUF(summaries[value].minUF),
    },
  ])
);
---

<section style="padding:88px var(--pad-x);background:var(--c-dark);color:var(--c-surface);">
  <div style="max-width:760px;margin:0 auto;text-align:center;">
    <p style="font-size:13px;letter-spacing:3px;text-transform:uppercase;color:var(--c-on-dark-muted);margin:0 0 14px;">Cotizador simple</p>
    <h2 style="font-family:var(--font-serif);font-size:clamp(30px,3.8vw,46px);font-weight:400;line-height:1.1;margin:0 0 12px;color:var(--c-on-dark);">Estima tu departamento</h2>
    <p style="font-size:15px;color:var(--c-on-dark-muted);margin:0 0 40px;">Selecciona una tipología para ver su metraje y disponibilidad real. El valor final depende de la unidad específica.</p>
  </div>

  <div style="max-width:760px;margin:0 auto;background:var(--c-bg);border:1px solid var(--c-dark-line);padding:clamp(20px, 5vw, 40px);color:var(--c-text);">
    <div style="margin-bottom:28px;">
      <div style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--c-muted);margin-bottom:12px;">Tipología</div>
      <div class="cotiz-group" style="display:flex;gap:12px;flex-wrap:wrap;" data-group="tipologia">
        {options.map(({ value, label }, i) => (
          <button type="button" class={`cotiz-btn${i === 0 ? ' active' : ''}`} data-value={value} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>
        ))}
      </div>
    </div>
    <div style="background:var(--c-surface);padding:28px;text-align:center;">
      <div style="font-size:13px;color:var(--c-muted);margin-bottom:8px;">Metraje</div>
      <div id="m2-text" style="font-family:var(--font-serif);font-size:32px;color:var(--c-accent);margin-bottom:12px;">{data['E'].m2}</div>
      <div id="detalle-text" style="font-size:14px;color:var(--c-muted);margin-bottom:14px;">{data['E'].count} unidad{data['E'].count === 1 ? '' : 'es'} disponible{data['E'].count === 1 ? '' : 's'} en {data['E'].pisos}</div>
      <div style="padding-top:14px;border-top:1px solid var(--c-line);">
        <span style="font-size:13px;color:var(--c-muted);">Desde </span>
        <span id="uf-text" style="font-family:var(--font-serif);font-size:22px;color:var(--c-ink);">{data['E'].desde}</span>
      </div>
    </div>
    <a id="cotizar-link" href="/disponibilidad?tipologia=E" data-track="cotizador_ver_unidades" class="btn btn-dark" style="display:flex;margin-top:24px;">Ver unidades y cotizar</a>
    <a id="contacto-link" href="/contacto?tipologia=E" data-track="cotizador_contacto" style="display:block;text-align:center;margin-top:14px;font-size:14px;font-weight:500;">Prefiero que me contacten →</a>
  </div>
</section>

<style>
  .cotiz-btn {
    flex: 1;
    min-width: 130px;
    padding: 14px;
    font-size: 15px;
    font-family: var(--font-sans);
    border: 1px solid var(--c-line-strong);
    cursor: pointer;
    background: var(--c-bg);
    color: var(--c-text);
  }
  .cotiz-btn:focus-visible,
  #cotizar-link:focus-visible,
  #contacto-link:focus-visible {
    outline: 2px solid var(--c-ink);
    outline-offset: 2px;
  }

  .cotiz-btn.active {
    border: 1px solid var(--c-accent);
    background: var(--c-accent);
    color: var(--c-on-dark);
    font-weight: 500;
  }
</style>

<script define:vars={{ data }}>
  const tipologiaParam = { E: 'E', '1D': '1D', Duplex: 'Duplex', L: 'Local' };

  const m2Text = document.getElementById('m2-text');
  const detalleText = document.getElementById('detalle-text');
  const ufText = document.getElementById('uf-text');
  const cotizarLink = document.getElementById('cotizar-link');
  const contactoLink = document.getElementById('contacto-link');

  function update(value) {
    const d = data[value];
    if (m2Text) m2Text.textContent = d.m2;
    const unidad = d.count === 1 ? 'unidad disponible' : 'unidades disponibles';
    if (detalleText) detalleText.textContent = `${d.count} ${unidad} en ${d.pisos}`;
    if (ufText) ufText.textContent = d.desde;
    const param = tipologiaParam[value];
    if (cotizarLink) cotizarLink.setAttribute('href', `/disponibilidad?tipologia=${param}`);
    if (contactoLink) contactoLink.setAttribute('href', `/contacto?tipologia=${param}`);
  }

  document.querySelectorAll('.cotiz-group').forEach((group) => {
    group.querySelectorAll('.cotiz-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        group.querySelectorAll('.cotiz-btn').forEach((b) => {
          const activo = b === btn;
          b.classList.toggle('active', activo);
          b.setAttribute('aria-pressed', String(activo));
        });
        update(btn.dataset.value);
        window.track?.('cotizador_tipologia', { tipologia: btn.dataset.value });
      });
    });
  });
</script>
