---
import { summaries, formatM2, formatUF, formatPisos } from '../lib/unidades';

const options = [
  { value: 'E', label: 'E · Estudio' },
  { value: '1D', label: '1D · 1 Dormitorio' },
  { value: 'Duplex', label: 'Duplex' },
  { value: 'L', label: 'Locales Comerciales' },
];

// Todo se deriva del CSV: no hay textos de pisos ni precios escritos a mano.
const data = Object.fromEntries(
  options.map(({ value }) => [
    value,
    {
      m2: formatM2(summaries[value]),
      count: summaries[value].count,
      pisos: formatPisos(summaries[value].pisos),
      desde: formatUF(summaries[value].minUF),
    },
  ])
);
---

<section style="padding:88px var(--pad-x);background:oklch(19% 0.03 75);color:oklch(94% 0.014 75);">
  <div style="max-width:760px;margin:0 auto;text-align:center;">
    <p style="font-size:13px;letter-spacing:2px;text-transform:uppercase;color:oklch(68% 0.09 75);margin:0 0 14px;">Cotizador simple</p>
    <h2 style="font-family:'Lora',serif;font-size:32px;font-weight:500;margin:0 0 12px;color:oklch(98% 0.006 75);">Estima tu departamento</h2>
    <p style="font-size:15px;color:oklch(80% 0.014 75);margin:0 0 40px;">Selecciona una tipología para ver su metraje y disponibilidad real. El valor final depende de la unidad específica.</p>
  </div>

  <div style="max-width:760px;margin:0 auto;background:oklch(97% 0.01 75);border:1px solid oklch(38% 0.03 75);padding:clamp(20px, 5vw, 40px);color:oklch(25% 0.035 75);">
    <div style="margin-bottom:28px;">
      <div style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:oklch(45% 0.025 75);margin-bottom:12px;">Tipología</div>
      <div class="cotiz-group" style="display:flex;gap:12px;flex-wrap:wrap;" data-group="tipologia">
        {options.map(({ value, label }, i) => (
          <button type="button" class={`cotiz-btn${i === 0 ? ' active' : ''}`} data-value={value} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>
        ))}
      </div>
    </div>
    <div style="background:oklch(94% 0.014 75);padding:28px;text-align:center;">
      <div style="font-size:13px;color:oklch(45% 0.025 75);margin-bottom:8px;">Metraje</div>
      <div id="m2-text" style="font-family:'Lora',serif;font-size:32px;color:oklch(58% 0.09 75);margin-bottom:12px;">{data['E'].m2}</div>
      <div id="detalle-text" style="font-size:14px;color:oklch(45% 0.025 75);margin-bottom:14px;">{data['E'].count} unidad{data['E'].count === 1 ? '' : 'es'} disponible{data['E'].count === 1 ? '' : 's'} en {data['E'].pisos}</div>
      <div style="padding-top:14px;border-top:1px solid oklch(87% 0.014 75);">
        <span style="font-size:13px;color:oklch(45% 0.025 75);">Desde </span>
        <span id="uf-text" style="font-family:'Lora',serif;font-size:22px;color:oklch(48% 0.09 75);">{data['E'].desde}</span>
      </div>
    </div>
    <a id="cotizar-link" href="/disponibilidad?tipologia=E" data-track="cotizador_ver_unidades" style="display:block;text-align:center;margin-top:24px;background:oklch(58% 0.09 75);color:oklch(98% 0.006 75);padding:14px 28px;font-size:15px;font-weight:500;">Ver unidades y cotizar</a>
    <a id="contacto-link" href="/contacto?tipologia=E" data-track="cotizador_contacto" style="display:block;text-align:center;margin-top:14px;font-size:14px;font-weight:500;">Prefiero que me contacten →</a>
  </div>
</section>

<style>
  .cotiz-btn {
    flex: 1;
    min-width: 130px;
    padding: 14px;
    font-size: 15px;
    font-family: 'Work Sans', sans-serif;
    border: 1px solid oklch(83% 0.014 75);
    cursor: pointer;
    background: oklch(97% 0.01 75);
    color: oklch(25% 0.035 75);
  }
  .cotiz-btn:focus-visible,
  #cotizar-link:focus-visible,
  #contacto-link:focus-visible {
    outline: 2px solid oklch(48% 0.09 75);
    outline-offset: 2px;
  }

  .cotiz-btn.active {
    border: 1px solid oklch(58% 0.09 75);
    background: oklch(58% 0.09 75);
    color: oklch(98% 0.006 75);
    font-weight: 500;
  }
</style>

<script define:vars={{ data }}>
  const tipologiaParam = { E: 'E', '1D': '1D', Duplex: 'Duplex', L: 'Local' };

  const m2Text = document.getElementById('m2-text');
  const detalleText = document.getElementById('detalle-text');
  const ufText = document.getElementById('uf-text');
  const cotizarLink = document.getElementById('cotizar-link');
  const contactoLink = document.getElementById('contacto-link');

  function update(value) {
    const d = data[value];
    if (m2Text) m2Text.textContent = d.m2;
    const unidad = d.count === 1 ? 'unidad disponible' : 'unidades disponibles';
    if (detalleText) detalleText.textContent = `${d.count} ${unidad} en ${d.pisos}`;
    if (ufText) ufText.textContent = d.desde;
    const param = tipologiaParam[value];
    if (cotizarLink) cotizarLink.setAttribute('href', `/disponibilidad?tipologia=${param}`);
    if (contactoLink) contactoLink.setAttribute('href', `/contacto?tipologia=${param}`);
  }

  document.querySelectorAll('.cotiz-group').forEach((group) => {
    group.querySelectorAll('.cotiz-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        group.querySelectorAll('.cotiz-btn').forEach((b) => {
          const activo = b === btn;
          b.classList.toggle('active', activo);
          b.setAttribute('aria-pressed', String(activo));
        });
        update(btn.dataset.value);
        window.track?.('cotizador_tipologia', { tipologia: btn.dataset.value });
      });
    });
  });
</script>
