---
import { FORMSPREE_ENDPOINT, CONTACT_EMAIL, TIENE_WHATSAPP, WHATSAPP_DISPLAY, whatsappUrl } from '../lib/config';

const inputStyle =
  "flex:1;min-width:140px;padding:14px 16px;border:1px solid oklch(83% 0.014 75);font-size:15px;font-family:'Work Sans',sans-serif;background:oklch(97% 0.01 75);";
---

<section style="padding:96px var(--pad-x);text-align:center;">
  <h2 style="font-family:'Lora',serif;font-size:34px;font-weight:500;margin:0 0 16px;">Reserva desde ahora tu departamento</h2>
  <p style="font-size:16px;color:oklch(45% 0.025 75);max-width:520px;margin:0 auto 36px;">Proyecto en verde: los mejores pisos y orientaciones se reservan primero. Déjanos tus datos y te contactamos.</p>

  <div id="form-enviado" style="display:none;max-width:420px;margin:0 auto;padding:24px;border:1px solid oklch(58% 0.09 75);background:oklch(94% 0.014 75);">
    <p style="margin:0;font-size:15px;">Gracias, recibimos tus datos. Te contactaremos a la brevedad.</p>
  </div>
  <div id="form-error" role="alert" style="display:none;max-width:420px;margin:0 auto 20px;padding:16px;background:oklch(94% 0.014 75);border:1px solid oklch(55% 0.15 30);">
    <p id="form-error-texto" style="margin:0;font-size:14px;">Hubo un problema al enviar tu solicitud. Intenta de nuevo o escríbenos directo a <a href={`mailto:${CONTACT_EMAIL}`} style="color:oklch(25% 0.035 75);">{CONTACT_EMAIL}</a>.</p>
  </div>

  <form id="contacto-form" action={FORMSPREE_ENDPOINT} method="POST" novalidate style="max-width:520px;margin:0 auto;display:flex;gap:12px;flex-wrap:wrap;justify-content:center;">
    <input type="hidden" name="_subject" value="Nueva consulta — Patio Riquelme (Home)" />
    <!-- Honeypot anti-spam: Formspree descarta el envío si viene relleno. -->
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />

    <label for="home-nombre" class="sr-only">Nombre</label>
    <input type="text" id="home-nombre" name="nombre" required autocomplete="name" placeholder="Nombre" style={inputStyle} />

    <label for="home-email" class="sr-only">Email</label>
    <input type="email" id="home-email" name="email" required autocomplete="email" placeholder="Email" style={inputStyle} />

    <button type="submit" id="home-submit" style="background:oklch(58% 0.09 75);color:oklch(98% 0.006 75);border:none;padding:14px 28px;font-size:15px;font-weight:500;cursor:pointer;font-family:'Work Sans',sans-serif;">Quiero más información</button>
  </form>

  {TIENE_WHATSAPP && (
    <p style="margin:22px 0 0;font-size:15px;color:oklch(45% 0.025 75);">
      ¿Prefieres escribirnos directo?
      <a href={whatsappUrl()} target="_blank" rel="noopener" data-track="whatsapp_home" style="color:oklch(40% 0.09 75);border-bottom:1px solid oklch(48% 0.09 75);margin-left:4px;">WhatsApp {WHATSAPP_DISPLAY}</a>
    </p>
  )}
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #contacto-form :is(input, button):focus-visible {
    outline: 2px solid oklch(48% 0.09 75);
    outline-offset: 2px;
  }

  .campo-invalido {
    border-color: oklch(55% 0.15 30) !important;
  }
</style>

<script>
  import { emailValido, nombreValido, primerError } from '../lib/formValidacion';

  const form = document.getElementById('contacto-form') as HTMLFormElement | null;
  const enviado = document.getElementById('form-enviado');
  const error = document.getElementById('form-error');
  const errorTexto = document.getElementById('form-error-texto');
  const submit = document.getElementById('home-submit') as HTMLButtonElement | null;
  const errorHtmlOriginal = errorTexto?.innerHTML ?? '';

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement | null;

  function mostrarError(mensaje?: string) {
    if (!error || !errorTexto) return;
    errorTexto.innerHTML = mensaje ?? errorHtmlOriginal;
    error.style.display = 'block';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (error) error.style.display = 'none';

    const nombre = $('home-nombre');
    const email = $('home-email');

    const fallo = primerError([
      { el: nombre, ok: nombreValido(nombre?.value ?? ''), mensaje: 'Escribe tu nombre.' },
      { el: email, ok: emailValido(email?.value ?? ''), mensaje: 'Revisa tu email: no parece una dirección válida.' },
    ]);
    if (fallo) {
      mostrarError(fallo.mensaje);
      fallo.el?.focus();
      return;
    }

    if (submit) {
      submit.disabled = true;
      submit.textContent = 'Enviando…';
    }
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.style.display = 'none';
        if (enviado) enviado.style.display = 'block';
        (window as any).track?.('contacto_enviado', { origen: 'home' });
      } else {
        mostrarError();
        (window as any).track?.('contacto_error', { origen: 'home', status: res.status });
      }
    } catch {
      mostrarError();
      (window as any).track?.('contacto_error', { origen: 'home', status: 'network' });
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.textContent = 'Quiero más información';
      }
    }
  });
</script>
