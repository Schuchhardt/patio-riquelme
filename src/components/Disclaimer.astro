---
import { DISCLAIMER_LEY_19472 } from '../lib/config';

interface Props {
  /** 'light' sobre fondo claro, 'dark' sobre fondo oscuro. */
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;

const color = tone === 'dark' ? 'oklch(58% 0.025 75)' : 'oklch(50% 0.025 75)';
const border = tone === 'dark' ? 'oklch(38% 0.03 75)' : 'oklch(87% 0.014 75)';
---

<aside
  aria-label="Información legal"
  style={`padding:24px var(--pad-x);border-top:1px solid ${border};`}
>
  <p style={`max-width:1200px;margin:0 auto;font-size:12px;line-height:1.6;color:${color};`}>
    {DISCLAIMER_LEY_19472}
  </p>
</aside>
