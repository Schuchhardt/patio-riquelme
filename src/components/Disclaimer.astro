---
import { DISCLAIMER_LEY_19472 } from '../lib/config';

interface Props {
  /** 'light' sobre fondo claro, 'dark' sobre fondo oscuro. */
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;

const color = tone === 'dark' ? 'var(--c-on-dark-faint)' : 'var(--c-muted)';
const border = tone === 'dark' ? 'var(--c-dark-line)' : 'var(--c-line)';
---

<aside
  aria-label="Información legal"
  style={`padding:24px var(--pad-x);border-top:1px solid ${border};`}
>
  <p style={`max-width:1240px;margin:0 auto;font-size:11.5px;line-height:1.6;color:${color};`}>
    {DISCLAIMER_LEY_19472}
  </p>
</aside>
