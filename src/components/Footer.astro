---
import { Image } from 'astro:assets';
import Disclaimer from './Disclaimer.astro';
import iconLogo from '../assets/logo-transparent.png';
import {
  CONTACT_EMAIL,
  CREDITOS,
  SALA_VENTAS_DIRECCION,
  SALA_VENTAS_HORARIO,
  TIENE_WHATSAPP,
  WHATSAPP_DISPLAY,
  whatsappUrl,
} from '../lib/config';

interface Props {
  /** 'full' con créditos del proyecto; 'simple' sin ellos. */
  variant?: 'full' | 'simple';
}

const { variant = 'full' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div>
        <a href="/" aria-label="Patio Riquelme — Inicio" style="display:inline-block;margin-bottom:22px;">
          <Image src={iconLogo} alt="" width={40} height={40} style="height:40px;width:auto;filter:brightness(0) invert(1);" />
        </a>
        <p class="footer-tagline">Vive el centro. Con historia.</p>
        <p class="footer-text">Guardia Marina Ernesto Riquelme 536<br />Santo Domingo 1720, Santiago Centro</p>
      </div>

      <div>
        <div class="footer-title">Navegación</div>
        <ul class="footer-list">
          <li><a href="/tipologias">Tipologías</a></li>
          <li><a href="/disponibilidad">Disponibilidad</a></li>
          <li><a href="/ubicacion">Ubicación</a></li>
          <li><a href="/contacto">Contacto</a></li>
          <li><a href="/brochure.pdf" download data-track="descargar_brochure" data-track-label="footer">Brochure (PDF)</a></li>
        </ul>
      </div>

      <div>
        <div class="footer-title">Contacto</div>
        <ul class="footer-list">
          <li><a href={`mailto:${CONTACT_EMAIL}`} data-track="email_footer">{CONTACT_EMAIL}</a></li>
          {TIENE_WHATSAPP && (
            <li><a href={whatsappUrl()} target="_blank" rel="noopener" data-track="whatsapp_footer">WhatsApp {WHATSAPP_DISPLAY}</a></li>
          )}
          <li>
            <a href="https://www.instagram.com/patioriquelme" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" /></svg>
              @patioriquelme
            </a>
          </li>
          {SALA_VENTAS_HORARIO && (
            <li class="footer-text" style="margin-top:6px;">Sala de ventas: {SALA_VENTAS_DIRECCION}<br />{SALA_VENTAS_HORARIO}</li>
          )}
        </ul>
      </div>
    </div>

    {variant === 'full' && CREDITOS.length > 0 && (
      <div class="footer-credits">
        <div class="footer-title">Créditos del proyecto</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:28px;align-items:start;">
          {CREDITOS.map((c) => (
            <div>
              <div style="font-size:11px;text-transform:uppercase;letter-spacing:1.5px;color:var(--c-on-dark-faint);margin-bottom:8px;">{c.rol}</div>
              {c.logo ? (
                <img src={c.logo} alt={`${c.rol}: ${c.nombre}`} loading="lazy" style="max-height:44px;width:auto;max-width:100%;display:block;margin-bottom:6px;" />
              ) : null}
              {c.url ? (
                <a href={c.url} target="_blank" rel="noopener" style="color:var(--c-on-dark-muted);font-size:14px;">{c.nombre}</a>
              ) : (
                <div style="color:var(--c-on-dark-muted);font-size:14px;">{c.nombre}</div>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="footer-bottom">© {year} Patio Riquelme. Todos los derechos reservados.</div>
  </div>

  <Disclaimer tone="dark" />
</footer>

<style>
  .site-footer {
    background: var(--c-footer);
    color: var(--c-on-dark-muted);
  }

  .footer-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 80px var(--pad-x) 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: var(--cols-footer);
    gap: 48px;
  }

  .footer-tagline {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 300;
    font-style: italic;
    color: var(--c-on-dark);
    margin: 0 0 14px;
  }

  .footer-text {
    font-size: 14px;
    line-height: 1.7;
    color: var(--c-on-dark-soft);
    margin: 0;
  }

  .footer-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--c-on-dark);
    margin-bottom: 22px;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 14px;
  }

  .footer-list a {
    color: var(--c-on-dark-muted);
  }

  .footer-list a:hover {
    color: var(--c-on-dark);
    opacity: 1;
  }

  .footer-credits {
    margin-top: 56px;
    padding-top: 36px;
    border-top: 1px solid var(--c-dark-line);
  }

  .footer-bottom {
    margin-top: 56px;
    padding: 28px 0;
    border-top: 1px solid var(--c-dark-line);
    text-align: center;
    font-size: 12px;
    color: var(--c-on-dark-faint);
  }
</style>
