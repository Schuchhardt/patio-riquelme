---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import renderFachadaPalma from '../assets/render-fachada-palma.png';
import { breadcrumbJsonLd } from '../lib/schema';
import {
  COORDENADAS,
  HITOS,
  MAPA_EMBED_URL,
  MAPA_LINK_EXTERNO,
  METRO_FRASE_CORTA,
} from '../lib/config';

const title = 'Ubicación — Santo Domingo, Santiago Centro | Patio Riquelme';
const description =
  `Patio Riquelme está en Santo Domingo. ${METRO_FRASE_CORTA}, 15 minutos caminando de Plaza de Armas y 10 del Barrio Brasil, Santiago Centro.`;

const breadcrumbs = breadcrumbJsonLd([
  { name: 'Inicio', path: '/' },
  { name: 'Ubicación', path: '/ubicacion/' },
]);

const placeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: 'Patio Riquelme',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Guardia Marina Ernesto Riquelme 536 / Santo Domingo 1720',
    addressLocality: 'Santiago',
    addressRegion: 'Región Metropolitana',
    addressCountry: 'CL',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: COORDENADAS.lat,
    longitude: COORDENADAS.lng,
  },
};
---

<BaseLayout title={title} description={description} path="/ubicacion/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(placeJsonLd)} />

  <Header current="ubicacion" />

  <main>
  <section class="page-intro" style="padding:clamp(64px,9vw,128px) var(--pad-x) 48px;--intro-w:760px;">
    <p style="font-size:12px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--c-eyebrow);margin:0 0 14px;">Ubicación y conectividad</p>
    <h1 style="font-family:var(--font-serif);font-size:clamp(40px,5.6vw,72px);font-weight:300;margin:0 0 28px;line-height:1.04;letter-spacing:-0.02em;">Santo Domingo, a pasos de todo</h1>
    <p style="font-size:16px;line-height:1.7;color:var(--c-text-2);margin:0;">Un barrio tranquilo e histórico con excelente conectividad hacia el resto de la ciudad.</p>
  </section>

  <section style="padding:0 var(--pad-x) 56px;max-width:1200px;margin:0 auto;">
    <div style="border:1px solid var(--c-line);height:420px;overflow:hidden;">
      <iframe
        title="Mapa de ubicación de Patio Riquelme"
        src={MAPA_EMBED_URL}
        loading="lazy"
        style="width:100%;height:100%;border:0;"
      ></iframe>
    </div>
    <p style="font-size:13px;color:var(--c-muted);margin-top:12px;">
      Guardia Marina Ernesto Riquelme 536 y Santo Domingo 1720, Santiago Centro.
      <a href={MAPA_LINK_EXTERNO} target="_blank" rel="noopener" data-track="abrir_mapa" style="color:var(--c-ink);border-bottom:1px solid var(--c-ink);margin-left:6px;">Abrir en Google Maps →</a>
    </p>
  </section>

  <section style="padding:24px var(--pad-x) 88px;display:grid;grid-template-columns:var(--cols-2-loc);gap:40px;max-width:1200px;margin:0 auto;align-items:start;">
    <div>
      <h2 style="font-family:var(--font-serif);font-size:28px;font-weight:400;margin:0 0 28px;">Conectividad</h2>
      <div style="display:flex;flex-direction:column;gap:22px;">
        {HITOS.map((h, i) => (
          <div style={`display:flex;gap:16px;${i < HITOS.length - 1 ? 'padding-bottom:20px;border-bottom:1px solid var(--c-line);' : ''}`}>
            {h.valor && (
              <div style="font-family:var(--font-serif);font-size:20px;color:var(--c-accent);min-width:56px;">{h.valor}</div>
            )}
            <div>
              <div style="font-weight:600;font-size:15px;">{h.nombre}</div>
              <div style="font-size:14px;color:var(--c-muted);">{h.detalle}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div style="border:1px solid var(--c-line);">
      <Image src={renderFachadaPalma} alt="Entorno del proyecto Patio Riquelme" style="width:100%;height:auto;display:block;" />
    </div>
  </section>

  <section style="padding:88px var(--pad-x);background:var(--c-surface);">
    <div style="max-width:760px;margin:0 auto;text-align:center;">
      <p style="font-size:12px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--c-eyebrow);margin:0 0 14px;">El barrio</p>
      <h2 style="font-family:var(--font-serif);font-size:clamp(30px,3.8vw,46px);font-weight:400;line-height:1.1;margin:0 0 20px;">Santo Domingo y Barrio Brasil</h2>
      <p style="font-size:16px;line-height:1.7;color:var(--c-text-2);margin:0;">Un sector residencial tranquilo dentro del centro histórico de Santiago, reconocido por su arquitectura patrimonial, sus plazas y una vida de barrio que convive con la mejor conectividad de la ciudad.</p>
    </div>
  </section>

  </main>

  <Footer variant="simple" />
</BaseLayout>
