---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

import hero from '../assets/hero.png';
import fachadaRiquelme from '../assets/fachada-riquelme.png';
import fachadaSantoDomingo from '../assets/fachada-santo-domingo.png';
import renderPatioInterior from '../assets/render-patio-interior.jpeg';
import renderDormitorio from '../assets/render-dormitorio.jpeg';
import fachadaCalleReferencia from '../assets/fachada-calle-referencia.jpeg';
import renderBimAvance from '../assets/render-bim-avance.png';
import renderFachadaPalma from '../assets/render-fachada-palma.png';
import logoPatioRiquelme from '../assets/logo-patio-riquelme.png';
import footerImg from '../assets/footer.png';
import { summaries } from '../lib/unidades';

const minM2Residencial = Math.min(summaries['E'].minM2, summaries['1D'].minM2);

const title = 'Patio Riquelme — Departamentos en el centro de Santiago';
const description =
  'Estudios, 1 dormitorio, duplex y locales comerciales en fachadas patrimoniales restauradas, Santo Domingo, Santiago Centro. A 1 cuadra del Metro Santa Ana.';

const apartmentComplexJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ApartmentComplex',
  name: 'Patio Riquelme',
  description,
  url: 'https://patioriquelme.cl',
  image: 'https://patioriquelme.cl/og-image.jpg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Guardia Marina Ernesto Riquelme 536 / Santo Domingo 1720',
    addressLocality: 'Santiago',
    addressRegion: 'Región Metropolitana',
    addressCountry: 'CL',
  },
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Fachadas patrimoniales restauradas', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'A 1 cuadra del Metro Santa Ana', value: true },
  ],
  numberOfFloors: 5,
};
---

<BaseLayout title={title} description={description} path="/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(apartmentComplexJsonLd)} />

  <Header current="inicio" />

  <main>
  <section style="position:relative;height:88vh;min-height:560px;display:flex;align-items:flex-end;">
    <Image src={hero} alt="Fachada patrimonial Patio Riquelme" loading="eager" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 25%;" />
    <div style="position:absolute;inset:0;background:linear-gradient(180deg, oklch(19% 0.03 75 / 0.15) 0%, oklch(14% 0.03 75 / 0.75) 100%);"></div>
    <div style="position:relative;padding:0 var(--pad-x) 48px;max-width:820px;">
      <p style="font-size:14px;letter-spacing:2px;text-transform:uppercase;color:oklch(74% 0.085 75);margin:0 0 14px;">Proyecto en construcción · Centro de Santiago</p>
      <h1 style="font-family:'Lora',serif;font-size:clamp(38px,5.5vw,62px);line-height:1.1;letter-spacing:4px;text-transform:uppercase;color:oklch(98% 0.006 75);margin:0 0 20px;font-weight:500;">Patio Riquelme</h1>
      <div style="width:56px;height:1px;background:oklch(68% 0.09 75);margin:0 0 20px;"></div>
      <p style="font-size:15px;letter-spacing:2px;text-transform:uppercase;color:oklch(74% 0.09 75);margin:0 0 14px;">Vive el centro. Con historia.</p>
      <p style="font-size:19px;line-height:1.5;color:oklch(94% 0.014 75);max-width:640px;margin:0 0 32px;">Estudios, departamentos de 1 dormitorio y duplex dentro de dos fachadas patrimoniales restauradas, a una cuadra del Metro Santa Ana.</p>
      <div style="display:flex;gap:16px;flex-wrap:wrap;">
        <a href="/contacto" style="background:oklch(58% 0.09 75);color:oklch(98% 0.006 75);padding:14px 28px;font-size:15px;font-weight:500;border-radius:2px;">Agendar visita</a>
        <a href="/brochure.pdf" download target="_blank" style="border:1px solid oklch(94% 0.014 75 / 0.6);color:oklch(98% 0.006 75);padding:14px 28px;font-size:15px;font-weight:500;border-radius:2px;">Descargar brochure</a>
      </div>
    </div>
  </section>

  <section style="display:grid;grid-template-columns:var(--cols-4);border-bottom:1px solid oklch(87% 0.014 75);">
    <div style="padding:32px 24px;text-align:center;border-right:1px solid oklch(87% 0.014 75);">
      <div style="font-family:'Lora',serif;font-size:30px;color:oklch(58% 0.09 75);">5</div>
      <div style="font-size:13px;color:oklch(45% 0.025 75);margin-top:4px;">pisos</div>
    </div>
    <div style="padding:32px 24px;text-align:center;border-right:1px solid oklch(87% 0.014 75);">
      <div style="font-family:'Lora',serif;font-size:30px;color:oklch(58% 0.09 75);">2</div>
      <div style="font-size:13px;color:oklch(45% 0.025 75);margin-top:4px;">accesos patrimoniales</div>
    </div>
    <div style="padding:32px 24px;text-align:center;border-right:1px solid oklch(87% 0.014 75);">
      <div style="font-family:'Lora',serif;font-size:30px;color:oklch(58% 0.09 75);">{Math.floor(minM2Residencial)} m²</div>
      <div style="font-size:13px;color:oklch(45% 0.025 75);margin-top:4px;">desde</div>
    </div>
    <div style="padding:32px 24px;text-align:center;">
      <div style="font-family:'Lora',serif;font-size:30px;color:oklch(58% 0.09 75);">2027–28</div>
      <div style="font-size:13px;color:oklch(45% 0.025 75);margin-top:4px;">entrega estimada</div>
    </div>
  </section>

  <section id="proyecto" style="display:grid;grid-template-columns:var(--cols-2);gap:0;align-items:stretch;">
    <div style="padding:88px var(--pad-x);display:flex;flex-direction:column;justify-content:center;max-width:560px;">
      <p style="font-size:13px;letter-spacing:2px;text-transform:uppercase;color:oklch(58% 0.09 75);margin:0 0 14px;">El proyecto</p>
      <h2 style="font-family:'Lora',serif;font-size:36px;font-weight:500;margin:0 0 20px;line-height:1.15;">Fachada patrimonial, vida nueva por dentro</h2>
      <p style="font-size:16px;line-height:1.7;color:oklch(38% 0.03 75);margin:0 0 16px;">Patio Riquelme conserva y restaura las fachadas históricas de sus dos accesos —Guardia Marina Ernesto Riquelme 536 y Santo Domingo 1720— declaradas parte del patrimonio del barrio. Por dentro, un edificio nuevo de 5 pisos con departamentos estudio, 1 dormitorio y duplex, además de 6 locales comerciales en el primer piso, pensados para quienes valoran vivir en el centro con carácter propio.</p>
      <p style="font-size:16px;line-height:1.7;color:oklch(38% 0.03 75);margin:0;">Es lo que distingue a Patio Riquelme de otros proyectos del sector: no borramos la historia del barrio, construimos sobre ella.</p>
    </div>
    <div style="min-height:480px;">
      <Image src={fachadaSantoDomingo} alt="Fachada Santo Domingo 1720 restaurada" style="width:100%;height:100%;object-fit:cover;display:block;" />
    </div>
  </section>

  <section style="padding:88px var(--pad-x);background:oklch(94% 0.014 75);">
    <p style="font-size:13px;letter-spacing:2px;text-transform:uppercase;color:oklch(58% 0.09 75);margin:0 0 14px;text-align:center;">Dos entradas, un mismo edificio</p>
    <h2 style="font-family:'Lora',serif;font-size:32px;font-weight:500;margin:0 0 48px;text-align:center;">Accesos</h2>
    <div style="display:grid;grid-template-columns:var(--cols-2);gap:40px;max-width:1100px;margin:0 auto;">
      <div style="background:oklch(97% 0.01 75);border:1px solid oklch(87% 0.014 75);">
        <div style="height:260px;overflow:hidden;"><Image src={fachadaRiquelme} alt="Acceso Guardia Marina Ernesto Riquelme 536" style="width:100%;height:100%;object-fit:cover;object-position:center 25%;" /></div>
        <div style="padding:28px;">
          <h3 style="font-family:'Lora',serif;font-size:20px;font-weight:500;margin:0 0 8px;">Guardia Marina Ernesto Riquelme 536</h3>
          <p style="font-size:15px;color:oklch(45% 0.025 75);line-height:1.6;margin:0;">Fachada de casona restaurada, con sus puertas y balcones originales conservados.</p>
        </div>
      </div>
      <div style="background:oklch(97% 0.01 75);border:1px solid oklch(87% 0.014 75);">
        <div style="height:260px;overflow:hidden;"><Image src={fachadaSantoDomingo} alt="Acceso Santo Domingo 1720" style="width:100%;height:100%;object-fit:cover;object-position:center 40%;" /></div>
        <div style="padding:28px;">
          <h3 style="font-family:'Lora',serif;font-size:20px;font-weight:500;margin:0 0 8px;">Santo Domingo 1720</h3>
          <p style="font-size:15px;color:oklch(45% 0.025 75);line-height:1.6;margin:0;">Fachada con detalles clásicos y molduras, integrada a la nueva estructura interior.</p>
        </div>
      </div>
    </div>
  </section>

  <section style="padding:88px var(--pad-x) 40px;">
    <p style="font-size:13px;letter-spacing:2px;text-transform:uppercase;color:oklch(58% 0.09 75);margin:0 0 14px;text-align:center;">Galería</p>
    <h2 style="font-family:'Lora',serif;font-size:32px;font-weight:500;margin:0 0 48px;text-align:center;">Renders y referencias del proyecto</h2>
    <div style="display:grid;grid-template-columns:var(--cols-2-gallery);gap:20px;max-width:1200px;margin:0 auto;">
      <div style="grid-row:span 2;overflow:hidden;"><Image src={renderPatioInterior} alt="Render patio interior con jardineras" style="width:100%;height:100%;object-fit:cover;display:block;" /></div>
      <div style="overflow:hidden;"><Image src={renderDormitorio} alt="Render dormitorio con balcón" style="width:100%;height:100%;object-fit:cover;display:block;" /></div>
      <div style="overflow:hidden;"><Image src={fachadaCalleReferencia} alt="Referencia de fachada restaurada en el barrio" style="width:100%;height:100%;object-fit:cover;display:block;" /></div>
    </div>
  </section>

  <section style="padding:40px var(--pad-x) 88px;">
    <div style="display:grid;grid-template-columns:var(--cols-2);gap:64px;align-items:center;max-width:1200px;margin:0 auto;">
      <div>
        <p style="font-size:13px;letter-spacing:2px;text-transform:uppercase;color:oklch(58% 0.09 75);margin:0 0 14px;">Avance de obra</p>
        <h2 style="font-family:'Lora',serif;font-size:32px;font-weight:500;margin:0 0 32px;">Un proyecto en marcha, no en el papel</h2>
        <div style="display:flex;flex-direction:column;gap:0;">
          <div style="display:flex;gap:16px;padding-bottom:24px;border-left:2px solid oklch(58% 0.09 75);padding-left:20px;margin-left:6px;position:relative;">
            <div style="position:absolute;left:-7px;top:0;width:12px;height:12px;border-radius:50%;background:oklch(58% 0.09 75);"></div>
            <div><div style="font-weight:600;font-size:15px;">Excavación completada</div><div style="font-size:14px;color:oklch(45% 0.025 75);">Etapa finalizada</div></div>
          </div>
          <div style="display:flex;gap:16px;padding-bottom:24px;border-left:2px solid oklch(58% 0.09 75);padding-left:20px;margin-left:6px;position:relative;">
            <div style="position:absolute;left:-7px;top:0;width:12px;height:12px;border-radius:50%;background:oklch(58% 0.09 75);"></div>
            <div><div style="font-weight:600;font-size:15px;">Permiso de edificación aprobado</div><div style="font-size:14px;color:oklch(45% 0.025 75);">Autorización municipal en regla</div></div>
          </div>
          <div style="display:flex;gap:16px;padding-bottom:24px;border-left:2px solid oklch(58% 0.09 75);padding-left:20px;margin-left:6px;position:relative;">
            <div style="position:absolute;left:-7px;top:0;width:12px;height:12px;border-radius:50%;background:oklch(58% 0.09 75);"></div>
            <div><div style="font-weight:600;font-size:15px;">Inicio de obras</div><div style="font-size:14px;color:oklch(45% 0.025 75);">En curso</div></div>
          </div>
          <div style="display:flex;gap:16px;padding-left:20px;margin-left:6px;position:relative;">
            <div style="position:absolute;left:-7px;top:0;width:12px;height:12px;border-radius:50%;background:oklch(87% 0.014 75);border:2px solid oklch(58% 0.09 75);"></div>
            <div><div style="font-weight:600;font-size:15px;">Entrega estimada</div><div style="font-size:14px;color:oklch(45% 0.025 75);">Fines de 2027 – inicios de 2028</div></div>
          </div>
        </div>
      </div>
      <div style="border:1px solid oklch(87% 0.014 75);">
        <Image src={renderBimAvance} alt="Modelo del proyecto en desarrollo" style="width:100%;height:auto;display:block;" />
        <p style="font-family:monospace;font-size:12px;color:oklch(45% 0.025 75);padding:12px 16px;margin:0;border-top:1px solid oklch(87% 0.014 75);">modelo referencial del proyecto — sujeto a cambios en obra</p>
      </div>
    </div>
  </section>

  <section style="padding:88px var(--pad-x);background:oklch(19% 0.03 75);color:oklch(94% 0.014 75);">
    <div style="display:grid;grid-template-columns:var(--cols-2);gap:64px;align-items:center;max-width:1200px;margin:0 auto;">
      <div>
        <p style="font-size:13px;letter-spacing:2px;text-transform:uppercase;color:oklch(68% 0.09 75);margin:0 0 14px;">El barrio</p>
        <h2 style="font-family:'Lora',serif;font-size:32px;font-weight:500;margin:0 0 20px;color:oklch(98% 0.006 75);">Barrio Santo Domingo, en el corazón de Santiago</h2>
        <p style="font-size:16px;line-height:1.7;color:oklch(87% 0.014 75);margin:0 0 28px;">Un sector tranquilo e histórico con excelente conectividad: a pasos del Metro, caminando al centro, y a minutos del Barrio Brasil.</p>
        <div style="display:flex;flex-direction:column;gap:14px;">
          <div style="display:flex;gap:12px;align-items:baseline;"><span style="color:oklch(68% 0.09 75);font-family:'Lora',serif;">—</span><span style="font-size:15px;">1 cuadra del Metro Santa Ana</span></div>
          <div style="display:flex;gap:12px;align-items:baseline;"><span style="color:oklch(68% 0.09 75);font-family:'Lora',serif;">—</span><span style="font-size:15px;">15 minutos a pie de Plaza de Armas y el centro histórico</span></div>
          <div style="display:flex;gap:12px;align-items:baseline;"><span style="color:oklch(68% 0.09 75);font-family:'Lora',serif;">—</span><span style="font-size:15px;">A minutos del Barrio Brasil</span></div>
        </div>
        <a href="/ubicacion" style="display:inline-block;margin-top:28px;color:oklch(74% 0.09 75);font-size:15px;border-bottom:1px solid oklch(74% 0.09 75);">Ver mapa y conectividad completa →</a>
      </div>
      <div style="border:1px solid oklch(38% 0.03 75);">
        <Image src={renderFachadaPalma} alt="Render fachada Patio Riquelme" style="width:100%;height:auto;display:block;" />
      </div>
    </div>
  </section>

  <ContactForm />

  <section style="padding:80px var(--pad-x);background:oklch(97% 0.01 75);text-align:center;">
    <Image src={footerImg} alt="Patio Riquelme" style="max-width:340px;width:100%;height:auto;display:inline-block;" />
  </section>
  </main>

  <Footer />
</BaseLayout>
