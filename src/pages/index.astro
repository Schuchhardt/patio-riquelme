---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

import hero from '../assets/hero.png';
import fachadaRiquelme from '../assets/fachada-riquelme.png';
import fachadaSantoDomingo from '../assets/fachada-santo-domingo.png';
import renderPatioInterior from '../assets/render-patio-interior.jpeg';
import renderDormitorio from '../assets/render-dormitorio.jpeg';
import fachadaCalleReferencia from '../assets/fachada-calle-referencia.jpeg';
import renderBimAvance from '../assets/render-bim-avance.png';
import renderFachadaPalma from '../assets/render-fachada-palma.png';
import { summaries } from '../lib/unidades';
import {
  ENTREGA_ESTIMADA,
  ENTREGA_ESTIMADA_CORTA,
  METRO_FRASE,
  METRO_FRASE_CORTA,
} from '../lib/config';

const minM2Residencial = Math.min(summaries['E'].minM2, summaries['1D'].minM2);

const title = 'Patio Riquelme — Departamentos en el centro de Santiago';
const description =
  `Estudios, 1 dormitorio, duplex y locales comerciales en fachadas patrimoniales restauradas, Santo Domingo, Santiago Centro. ${METRO_FRASE_CORTA}.`;

const apartmentComplexJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ApartmentComplex',
  name: 'Patio Riquelme',
  description,
  url: 'https://patioriquelme.cl',
  image: 'https://patioriquelme.cl/og-image.jpg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Guardia Marina Ernesto Riquelme 536 / Santo Domingo 1720',
    addressLocality: 'Santiago',
    addressRegion: 'Región Metropolitana',
    addressCountry: 'CL',
  },
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Fachadas patrimoniales restauradas', value: true },
    { '@type': 'LocationFeatureSpecification', name: METRO_FRASE_CORTA, value: true },
  ],
  numberOfFloors: 5,
};
---

<BaseLayout title={title} description={description} path="/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(apartmentComplexJsonLd)} />

  <Header current="inicio" overlay />

  <main>
  <!-- HERO -->
  <section class="hero">
    <Image src={hero} alt="Fachada patrimonial Patio Riquelme" loading="eager" fetchpriority="high" class="hero-img" />
    <div class="hero-shade"></div>
    <div class="hero-content">
      <p style="font-size:12px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:var(--c-on-dark-muted);margin:0 0 26px;">Proyecto en construcción · Santiago Centro</p>
      <h1 class="hero-title"><span class="sr-only">Patio Riquelme — </span>Vive el centro.<br /><em>Con historia.</em></h1>
      <p class="hero-sub">Estudios, departamentos de 1 dormitorio y duplex dentro de dos fachadas patrimoniales restauradas, {METRO_FRASE}.</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center;">
        <a href="/disponibilidad" class="btn btn-light" data-track="ver_disponibilidad" data-track-label="hero">Ver disponibilidad</a>
        <a href="/contacto" class="btn btn-ghost-light" data-track="agendar_visita" data-track-label="hero">Agendar visita</a>
      </div>
    </div>
    <div class="hero-foot">
      <span>Patio Riquelme</span>
      <span class="hero-foot-addr">Santo Domingo 1720 · Riquelme 536</span>
    </div>
  </section>

  <!-- FRANJA DE DATOS -->
  <section class="facts" aria-label="El proyecto en cifras">
    <div class="fact">
      <div class="fact-label">Edificio</div>
      <div class="fact-value">5 pisos</div>
    </div>
    <div class="fact">
      <div class="fact-label">Accesos</div>
      <div class="fact-value">2 fachadas patrimoniales</div>
    </div>
    <div class="fact">
      <div class="fact-label">Superficies</div>
      <div class="fact-value">Desde {Math.floor(minM2Residencial)} m²</div>
    </div>
    <div class="fact">
      <div class="fact-label">Entrega estimada</div>
      <div class="fact-value">{ENTREGA_ESTIMADA_CORTA}</div>
    </div>
  </section>

  <!-- EL PROYECTO -->
  <section id="proyecto" class="section">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">El proyecto</p>
        <h2 class="section-title">Fachada patrimonial, vida nueva por dentro</h2>
        <p class="lead">Patio Riquelme conserva y restaura las fachadas históricas de sus dos accesos —Guardia Marina Ernesto Riquelme 536 y Santo Domingo 1720— declaradas parte del patrimonio del barrio. Por dentro, un edificio nuevo de 5 pisos con departamentos estudio, 1 dormitorio y duplex, además de 6 locales comerciales en el primer piso, pensados para quienes valoran vivir en el centro con carácter propio.</p>
        <p class="lead">Es lo que distingue a Patio Riquelme de otros proyectos del sector: no borramos la historia del barrio, construimos sobre ella.</p>
        <a href="/tipologias" class="link-arrow" style="margin-top:12px;">Conoce las tipologías <span aria-hidden="true">→</span></a>
      </div>
      <div class="zoom reveal" style="aspect-ratio:4/5;">
        <Image src={renderFachadaPalma} alt="Render fachada Patio Riquelme" style="width:100%;height:100%;object-fit:cover;display:block;" />
      </div>
    </div>
  </section>

  <!-- ACCESOS -->
  <section class="section" style="background:var(--c-surface);">
    <div class="wrap">
      <div class="reveal" style="max-width:720px;margin-bottom:64px;">
        <p class="eyebrow">Dos entradas, un mismo edificio</p>
        <h2 class="section-title">Dos fachadas que cuentan la historia del barrio</h2>
        <p class="lead" style="margin:0;">Cada acceso conserva su carácter original y conduce al mismo patio interior.</p>
      </div>
      <div class="cards-2">
        <article class="card reveal">
          <div class="zoom card-media">
            <Image src={fachadaRiquelme} alt="Acceso Guardia Marina Ernesto Riquelme 536" style="width:100%;height:100%;object-fit:cover;object-position:center 25%;display:block;" />
            <span class="card-num">01</span>
          </div>
          <div class="card-body">
            <h3 class="card-title">Riquelme 536</h3>
            <p class="card-meta">Guardia Marina Ernesto Riquelme 536</p>
            <p class="card-text">Fachada de casona restaurada, con sus puertas y balcones originales conservados.</p>
          </div>
        </article>
        <article class="card reveal">
          <div class="zoom card-media">
            <Image src={fachadaSantoDomingo} alt="Acceso Santo Domingo 1720" style="width:100%;height:100%;object-fit:cover;object-position:center 40%;display:block;" />
            <span class="card-num">02</span>
          </div>
          <div class="card-body">
            <h3 class="card-title">Santo Domingo 1720</h3>
            <p class="card-meta">Santo Domingo 1720, Santiago Centro</p>
            <p class="card-text">Fachada con detalles clásicos y molduras, integrada a la nueva estructura interior.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- GALERÍA -->
  <section class="section">
    <div class="wrap">
      <div class="reveal" style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:56px;">
        <div style="max-width:640px;">
          <p class="eyebrow">Galería</p>
          <h2 class="section-title" style="margin:0;">Renders y referencias del proyecto</h2>
        </div>
        <a href="/brochure.pdf" download target="_blank" rel="noopener" class="link-arrow" data-track="descargar_brochure" data-track-label="galeria">Descargar brochure <span aria-hidden="true">↓</span></a>
      </div>
      <div class="gallery">
        <div class="zoom g-main reveal"><Image src={renderPatioInterior} alt="Render patio interior con jardineras" style="width:100%;height:100%;object-fit:cover;display:block;" /></div>
        <div class="zoom reveal"><Image src={renderDormitorio} alt="Render dormitorio con balcón" style="width:100%;height:100%;object-fit:cover;display:block;" /></div>
        <div class="zoom reveal"><Image src={fachadaCalleReferencia} alt="Referencia de fachada restaurada en el barrio" style="width:100%;height:100%;object-fit:cover;display:block;" /></div>
      </div>
    </div>
  </section>

  <!-- AVANCE DE OBRA -->
  <section class="section" style="padding-top:0;">
    <div class="wrap split" style="align-items:center;">
      <div class="reveal">
        <p class="eyebrow">Avance de obra</p>
        <h2 class="section-title" style="margin-bottom:40px;">Un proyecto en marcha, no en el papel</h2>
        <ol class="timeline">
          <li class="done"><span class="t-title">Excavación completada</span><span class="t-sub">Etapa finalizada</span></li>
          <li class="done"><span class="t-title">Permiso de edificación aprobado</span><span class="t-sub">Autorización municipal en regla</span></li>
          <li class="done"><span class="t-title">Inicio de obras</span><span class="t-sub">En curso</span></li>
          <li><span class="t-title">Entrega estimada</span><span class="t-sub">{ENTREGA_ESTIMADA}</span></li>
        </ol>
      </div>
      <figure class="reveal" style="margin:0;">
        <div style="background:var(--c-surface);">
          <Image src={renderBimAvance} alt="Modelo del proyecto en desarrollo" style="width:100%;height:auto;display:block;" />
        </div>
        <figcaption style="font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--c-eyebrow);padding-top:14px;">Modelo referencial del proyecto — sujeto a cambios en obra</figcaption>
      </figure>
    </div>
  </section>

  <!-- EL BARRIO -->
  <section class="barrio">
    <div class="barrio-media">
      <Image src={fachadaSantoDomingo} alt="Fachada Santo Domingo 1720 con terrazas del barrio" style="width:100%;height:100%;object-fit:cover;display:block;" />
    </div>
    <div class="barrio-body reveal">
      <p class="eyebrow" style="color:var(--c-on-dark-soft);">El barrio</p>
      <h2 class="section-title" style="color:var(--c-on-dark);">Barrio Santo Domingo, en el corazón de Santiago</h2>
      <p class="lead" style="color:var(--c-on-dark-muted);">Un sector tranquilo e histórico con excelente conectividad: a pasos del Metro, caminando al centro, y a 10 minutos del Barrio Brasil.</p>
      <ul class="barrio-list">
        <li><span class="b-num">2'</span><span>caminando del Metro Santa Ana</span></li>
        <li><span class="b-num">10'</span><span>a pie del Barrio Brasil</span></li>
        <li><span class="b-num">15'</span><span>a Plaza de Armas y el centro histórico</span></li>
      </ul>
      <a href="/ubicacion" class="btn btn-ghost-light" style="margin-top:36px;">Ver mapa y conectividad</a>
    </div>
  </section>

  <ContactForm />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 620px;
    margin-top: calc(-1 * var(--header-h));
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    color: #fff;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    animation: hero-zoom 14s ease-out both;
  }

  @keyframes hero-zoom {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 52%, rgb(14 13 12 / 0.45) 0%, rgb(14 13 12 / 0) 100%),
      linear-gradient(180deg, rgb(14 13 12 / 0.5) 0%, rgb(14 13 12 / 0.2) 30%, rgb(14 13 12 / 0.25) 60%, rgb(14 13 12 / 0.65) 100%);
  }

  .hero-content {
    position: relative;
    padding: var(--header-h) var(--pad-x) 0;
    max-width: 920px;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(44px, 7vw, 92px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 28px;
    color: #fff;
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.25);
  }

  .hero-title em {
    font-style: italic;
  }

  .hero-sub {
    font-size: clamp(16px, 1.6vw, 19px);
    font-weight: 300;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.88);
    max-width: 600px;
    margin: 0 auto 40px;
  }

  .hero-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.75);
  }

  .hero-foot-addr {
    color: rgb(255 255 255 / 0.95);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-img { animation: none; }
  }

  @media (max-width: 860px), (max-height: 700px) {
    .hero-foot { display: none; }
  }

  /* ---------- Franja de datos ---------- */
  .facts {
    display: grid;
    grid-template-columns: var(--cols-4);
    background: var(--c-dark);
    color: #fff;
  }

  .fact {
    padding: 30px 24px;
    text-align: center;
    border-right: 1px solid rgb(255 255 255 / 0.12);
  }

  .fact:last-child {
    border-right: none;
  }

  .fact-label {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
    margin-bottom: 8px;
  }

  .fact-value {
    font-size: 15px;
    color: rgb(255 255 255 / 0.92);
  }

  @media (max-width: 860px) {
    .fact { border-bottom: 1px solid rgb(255 255 255 / 0.12); }
    .fact:nth-child(2n) { border-right: none; }
  }

  /* ---------- Secciones ---------- */
  .section {
    padding: clamp(80px, 11vw, 140px) var(--pad-x);
  }

  .wrap {
    max-width: 1240px;
    margin: 0 auto;
  }

  .split {
    display: grid;
    grid-template-columns: var(--cols-2);
    gap: clamp(40px, 7vw, 110px);
    align-items: center;
  }

  .lead {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.75;
    color: var(--c-text-2);
    margin: 0 0 20px;
    max-width: 560px;
  }

  /* ---------- Cards numeradas ---------- */
  .cards-2 {
    display: grid;
    grid-template-columns: var(--cols-2);
    gap: 40px;
  }

  .card {
    background: var(--c-bg);
  }

  .card-media {
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .card-num {
    position: absolute;
    top: 20px;
    left: 22px;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(255 255 255 / 0.9);
  }

  .card-body {
    padding: 32px 32px 36px;
  }

  .card-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 28px;
    margin: 0 0 10px;
  }

  .card-meta {
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--c-muted);
    margin: 0 0 18px;
  }

  .card-text {
    font-size: 15px;
    line-height: 1.7;
    color: var(--c-text-2);
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid var(--c-line);
  }

  /* ---------- Galería ---------- */
  .gallery {
    display: grid;
    grid-template-columns: var(--cols-2-gallery);
    grid-auto-rows: minmax(260px, 34vw);
    gap: 16px;
  }

  .gallery .g-main {
    grid-row: span 2;
  }

  @media (min-width: 861px) {
    .gallery { grid-auto-rows: minmax(260px, 22vw); }
  }

  @media (max-width: 860px) {
    .gallery .g-main { grid-row: auto; }
  }

  /* ---------- Timeline ---------- */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: paso;
  }

  .timeline li {
    counter-increment: paso;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 0 20px 64px;
    border-top: 1px solid var(--c-line);
  }

  .timeline li:last-child {
    border-bottom: 1px solid var(--c-line);
  }

  .timeline li::before {
    content: counter(paso, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 21px;
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--c-eyebrow);
  }

  .timeline li.done::before {
    color: var(--c-text);
  }

  .t-title {
    font-size: 16px;
    font-weight: 500;
  }

  .t-sub {
    font-size: 14px;
    color: var(--c-muted);
  }

  /* ---------- Barrio ---------- */
  .barrio {
    display: grid;
    grid-template-columns: var(--cols-2);
    background: var(--c-dark);
    color: #fff;
  }

  .barrio-media {
    min-height: 520px;
  }

  .barrio-body {
    padding: clamp(64px, 9vw, 120px) var(--pad-x);
    max-width: 640px;
    align-self: center;
  }

  .barrio-list {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }

  .barrio-list li {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 16px 0;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-size: 15px;
    color: rgb(255 255 255 / 0.85);
  }

  .barrio-list li:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }

  .b-num {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 300;
    min-width: 48px;
    color: #fff;
  }

  @media (max-width: 860px) {
    .barrio-media { min-height: 320px; }
  }
</style>
