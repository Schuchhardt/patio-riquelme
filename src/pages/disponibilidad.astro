---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BuscadorUnidades from '../components/BuscadorUnidades.astro';
import { breadcrumbJsonLd } from '../lib/schema';
import {
  unidadesPublicas,
  departamentos,
  locales,
  desdeDepartamentos,
  desdeLocales,
  formatUF,
} from '../lib/unidades';

const title = 'Disponibilidad — Busca tu unidad y cotiza | Patio Riquelme';
const description =
  'Revisa las unidades disponibles en Patio Riquelme: filtra por tipología, piso y precio en UF, y solicita la cotización de la unidad que te interesa.';

const breadcrumbs = breadcrumbJsonLd([
  { name: 'Inicio', path: '/' },
  { name: 'Disponibilidad', path: '/disponibilidad/' },
]);

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Unidades disponibles — Patio Riquelme',
  numberOfItems: unidadesPublicas.length,
  itemListElement: unidadesPublicas.map((u, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: `Unidad ${u.nombre} — ${u.tipologiaLabel}`,
      category: u.tipologiaLabel,
      additionalProperty: [
        { '@type': 'PropertyValue', name: 'Superficie útil', value: `${u.m2Util} m²` },
        { '@type': 'PropertyValue', name: 'Superficie terraza', value: `${u.m2Terraza} m²` },
        { '@type': 'PropertyValue', name: 'Superficie total', value: `${u.m2Total} m²` },
        { '@type': 'PropertyValue', name: 'Piso', value: u.pisoLabel },
        { '@type': 'PropertyValue', name: 'Cuerpo', value: u.cuerpoLabel },
      ],
      offers: {
        '@type': 'Offer',
        availability: 'https://schema.org/PreOrder',
        price: u.uf,
        priceCurrency: 'CLF',
        url: 'https://patioriquelme.cl/disponibilidad/',
        seller: { '@type': 'RealEstateAgent', name: 'Patio Riquelme' },
      },
    },
  })),
};
---

<BaseLayout title={title} description={description} path="/disponibilidad/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />

  <Header current="disponibilidad" />

  <main>
  <section class="page-intro" style="padding:clamp(64px,9vw,128px) var(--pad-x) 48px;--intro-w:820px;">
    <p style="font-size:12px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--c-eyebrow);margin:0 0 14px;">Disponibilidad</p>
    <h1 style="font-family:var(--font-serif);font-size:clamp(40px,5.6vw,72px);font-weight:300;margin:0 0 28px;line-height:1.04;letter-spacing:-0.02em;">Encuentra tu unidad y cotízala</h1>
    <p style="font-size:16px;line-height:1.7;color:var(--c-text-2);margin:0 0 16px;">{departamentos.length} departamentos desde {formatUF(desdeDepartamentos)} y {locales.length} locales comerciales desde {formatUF(desdeLocales)}. Filtra por tipología, piso, cuerpo y rango de precio, y solicita la cotización de la unidad que te interese: te contactamos con el detalle y los pasos para la promesa de compraventa.</p>
    <p style="font-size:14px;line-height:1.7;color:var(--c-muted);margin:0;">Cada unidad muestra su <strong>superficie útil</strong> (interior), su <strong>terraza</strong> cuando la tiene, y la <strong>superficie total</strong> —la suma de ambas— que es la superficie sobre la que se cotiza. Dentro de una misma planta el precio sube con la altura, así que dos unidades idénticas en distintos pisos no valen lo mismo. Los valores son estimados en UF y están sujetos a confirmación al momento de la reserva.</p>
  </section>

  <BuscadorUnidades />

  </main>

  <Footer variant="simple" />
</BaseLayout>
