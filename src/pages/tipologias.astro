---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cotizador from '../components/Cotizador.astro';
import logoPatioRiquelme from '../assets/logo-patio-riquelme.png';
import { breadcrumbJsonLd } from '../lib/schema';

const title = 'Tipologías — Studio y 1 Dormitorio | Patio Riquelme';
const description =
  'Studios desde 15 m² y departamentos de 1 dormitorio desde 28 m² en Patio Riquelme, Santo Domingo, Santiago Centro. Cotiza tu metraje según piso.';

const breadcrumbs = breadcrumbJsonLd([
  { name: 'Inicio', path: '/' },
  { name: 'Tipologías', path: '/tipologias/' },
]);

const studioJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Studio — Patio Riquelme',
  description:
    'Aprox. 15–22 m² según piso. Living-dormitorio integrado, kitchenette y baño. Ideal para vivir solo, invertir o arrendar.',
  category: 'Departamento tipo studio',
  additionalProperty: [{ '@type': 'PropertyValue', name: 'Superficie', value: '15–22 m²' }],
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/PreOrder',
    priceCurrency: 'CLP',
    url: 'https://patioriquelme.cl/contacto/',
    seller: { '@type': 'RealEstateAgent', name: 'Patio Riquelme' },
  },
};

const dormitorioJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: '1 Dormitorio — Patio Riquelme',
  description:
    'Aprox. 28–38 m² según piso. Dormitorio separado, living-comedor, cocina y baño. Pensado para quienes buscan más espacio sin salir del centro.',
  category: 'Departamento de 1 dormitorio',
  additionalProperty: [{ '@type': 'PropertyValue', name: 'Superficie', value: '28–38 m²' }],
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/PreOrder',
    priceCurrency: 'CLP',
    url: 'https://patioriquelme.cl/contacto/',
    seller: { '@type': 'RealEstateAgent', name: 'Patio Riquelme' },
  },
};
---

<BaseLayout title={title} description={description} path="/tipologias/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(studioJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(dormitorioJsonLd)} />

  <Header current="tipologias" />

  <main>
  <section style="padding:80px var(--pad-x) 56px;max-width:760px;">
    <p style="font-size:13px;letter-spacing:2px;text-transform:uppercase;color:oklch(58% 0.09 75);margin:0 0 14px;">Tipologías</p>
    <h1 style="font-family:'Lora',serif;font-size:42px;font-weight:500;margin:0 0 20px;line-height:1.15;">Studios y departamentos de 1 dormitorio</h1>
    <p style="font-size:16px;line-height:1.7;color:oklch(38% 0.03 75);margin:0;">Desde 15 m². Cada piso conserva una planta distinta, por lo que el metraje exacto y el valor final varían según la unidad y su nivel. Usa el cotizador más abajo para una estimación referencial, o conversa con nuestro equipo de ventas.</p>
  </section>

  <section style="padding:0 var(--pad-x) 88px;display:grid;grid-template-columns:var(--cols-2);gap:40px;max-width:1200px;margin:0 auto;">
    <div style="border:1px solid oklch(87% 0.014 75);background:oklch(97% 0.01 75);">
      <div style="height:200px;background:repeating-linear-gradient(135deg, oklch(90% 0.02 70), oklch(90% 0.02 70) 12px, oklch(94% 0.014 75) 12px, oklch(94% 0.014 75) 24px);display:flex;align-items:center;justify-content:center;">
        <span style="font-family:monospace;font-size:12px;color:oklch(45% 0.025 75);">planta referencial — studio</span>
      </div>
      <div style="padding:32px;">
        <h3 style="font-family:'Lora',serif;font-size:24px;font-weight:500;margin:0 0 10px;">Studio</h3>
        <p style="font-size:15px;color:oklch(45% 0.025 75);line-height:1.6;margin:0 0 18px;">Aprox. 15 – 22 m² según piso. Living-dormitorio integrado, kitchenette y baño. Ideal para vivir solo, invertir o arrendar.</p>
        <a href="/contacto" style="font-size:14px;font-weight:500;border-bottom:1px solid oklch(48% 0.09 75);">Consultar disponibilidad →</a>
      </div>
    </div>
    <div style="border:1px solid oklch(87% 0.014 75);background:oklch(97% 0.01 75);">
      <div style="height:200px;background:repeating-linear-gradient(135deg, oklch(90% 0.02 70), oklch(90% 0.02 70) 12px, oklch(94% 0.014 75) 12px, oklch(94% 0.014 75) 24px);display:flex;align-items:center;justify-content:center;">
        <span style="font-family:monospace;font-size:12px;color:oklch(45% 0.025 75);">planta referencial — 1 dormitorio</span>
      </div>
      <div style="padding:32px;">
        <h3 style="font-family:'Lora',serif;font-size:24px;font-weight:500;margin:0 0 10px;">1 Dormitorio</h3>
        <p style="font-size:15px;color:oklch(45% 0.025 75);line-height:1.6;margin:0 0 18px;">Aprox. 28 – 38 m² según piso. Dormitorio separado, living-comedor, cocina y baño. Pensado para quienes buscan más espacio sin salir del centro.</p>
        <a href="/contacto" style="font-size:14px;font-weight:500;border-bottom:1px solid oklch(48% 0.09 75);">Consultar disponibilidad →</a>
      </div>
    </div>
  </section>

  <Cotizador />

  <section style="padding:80px var(--pad-x);background:oklch(97% 0.01 75);text-align:center;">
    <Image src={logoPatioRiquelme} alt="Patio Riquelme" style="max-width:340px;width:100%;height:auto;display:inline-block;" />
  </section>
  </main>

  <Footer variant="simple" />
</BaseLayout>
