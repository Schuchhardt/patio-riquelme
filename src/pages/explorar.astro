  function verEdificio(modo?: string) {
    state.id = '';
    const opciones: { label: string; id: string; go: () => void }[] = [];
    if (D.modelos.casa_munecas) {
      opciones.push({
        label: 'Unidades 3D',
        id: 'unidades3d',
        go: () => {
          rotulos('Unidades 3D', '', `Arrastra para girar · ${matchMedia('(hover: none)').matches ? 'toca' : 'clic en'} una unidad para ver su ficha`, true);
          mostrarCasa();
          track('explorar_casa', {});
        },
      });
    }
    if (D.modelos.edificio) {
      opciones.push({
        label: 'Modelo 3D',
        id: 'modelo',
        go: () => {
          rotulos('El edificio', 'Volumetría en revisión', 'Arrastra para girar · rueda para acercar', true);
          mostrarModelo(D.modelos.edificio, { orbit: '-30deg 65deg auto', autoRotate: true });
        },
      });
    }
    opciones.push({
      label: 'Sobrevuelo',
      id: 'sobrevuelo',
      go: () => {
        rotulos('El edificio', 'Animación Cycles · volumetría en revisión', 'Entrada Riquelme 536 → último piso abierto → entrada Santo Domingo');
        mostrarVideo(SOBREVUELO);
      },
    });
    opciones.push({
      label: 'De la calle al depto',
      id: 'recorrido_acceso',
      go: () => {
        rotulos('El edificio', 'Animación Cycles · acceso según láminas de abril', 'Portón de Santo Domingo → zaguán y conserjería → ascensor del cuerpo B → depto 304 B');
        mostrarVideo(RECORRIDO_ACCESO);
        track('explorar_video', { video: 'recorrido_acceso' });
      },
    });
    const NOMBRES: Record<string, string> = {
      conjunto_corte: 'Último piso abierto',
      conjunto_aerea: 'Vista aérea',
      conjunto_lateral: 'Vista lateral',
    };
    for (const id of ['conjunto_corte', 'conjunto_aerea', 'conjunto_lateral']) {
      const im = imgPorId.get(id);
      if (im)
        opciones.push({
          label: NOMBRES[id],
          id,
          go: () => {
            rotulos('El edificio', 'Render Cycles · volumetría en revisión', '');
            mostrarImagen(im.img, im.nombre);
          },
        });
    }
    if (recorridoPorId.has('edificio')) {
      opciones.push({ label: 'Desde Santo Domingo', id: 'recorrido', go: () => ir('recorridos', 'edificio') });
    }
    if (recorridoPorId.has('conjunto')) {
      opciones.push({
        label: '360°',
        id: '360',
        go: () => {
          rotulos('El conjunto', 'Desde Blender · escena de revisión', 'Arrastra para mirar en 360°');
          const r = recorridoPorId.get('conjunto')!;
          mostrarVistas(r.vistas, 0);
        },
      });
    }
    if (!opciones.length) {
      rotulos('El edificio', '', '');
      chips([]);
      const r = recorridoPorId.get('patio');
      if (r) mostrarVistas(r.vistas, 0);
      return;
    }
    const i = Math.max(0, opciones.findIndex((o) => o.id === modo));
    chips(opciones.map((o, j) => ({ label: o.label, key: o.id, on: j === i, go: o.go })));
    opciones[i].go();
  }

