---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { payload, departamentos, locales, recorridos } from '../lib/explorar';

const title = 'Explorar 3D — Recorridos 360°, plantas y modelo | Patio Riquelme';
const description = `Recorre Patio Riquelme en 360°, revisa la planta de cada una de sus ${departamentos.length} unidades y ${locales.length} locales, y arma tu selección para cotizar.`;

/**
 * Página pública: link «Explorar 3D» en Header.astro, indexable y en el sitemap.
 * La antigua URL no listada (/visor-360/) redirige aquí con un 301 en
 * public/_redirects. Para volver a ocultarla: `noindex` en BaseLayout, filtro en
 * astro.config.mjs, X-Robots-Tag en public/_headers y quitar el link del menú.
 */
const PATH = '/explorar/';

const tabs = [
  { id: 'edificio', label: 'Edificio 3D' },
  { id: 'unidades', label: 'Unidades' },
  { id: 'tipologias', label: 'Tipologías' },
  { id: 'locales', label: 'Locales' },
  { id: 'recorridos', label: 'Recorridos' },
  { id: 'imagenes', label: 'Imágenes' },
];

const portada = recorridos.find((r) => r.id === '304B') ?? recorridos[0];
// Sus renders pueden no estar listos todavía: el texto solo aparece cuando el recorrido existe.
const hayRecorridoEdificio = recorridos.some((r) => r.id === 'edificio');
---

<BaseLayout title={title} description={description} path={PATH}>
  {portada && (
    <>
      <link slot="head" rel="preload" as="image" href={portada.vistas[0].pano} media="(min-width: 861px)" />
      <link slot="head" rel="preload" as="image" href={portada.vistas[0].pano_m ?? portada.vistas[0].pano} media="(max-width: 860px)" />
    </>
  )}

  <Header current="explorar" />

  <main class="ex">
    <div class="ex-bar">
      <div>
        <p class="ex-eyebrow">Santiago Centro</p>
        <h1 class="ex-h1">Un lugar para descubrir.</h1>
      </div>
      <div class="ex-bar-actions">
        <button type="button" class="ex-link" id="sel-open" data-track="explorar_seleccion">
          Mi selección <span class="ex-count" id="sel-count">0</span>
        </button>
        <button type="button" class="ex-link" id="about-open">Sobre esta versión</button>
      </div>
    </div>

    <div class="ex-body">
      <aside class="ex-panel" aria-label="Contenido">
        <div class="ex-tabs" role="tablist">
          {tabs.map((t) => (
            <button type="button" role="tab" class="ex-tab" data-tab={t.id} aria-selected="false">{t.label}</button>
          ))}
        </div>
        <div id="ex-content" aria-live="polite">
          <noscript><p class="ex-note">Activa JavaScript para recorrer el proyecto en 360° y revisar las plantas.</p></noscript>
        </div>
        <p class="ex-foot" id="ex-foot"></p>
      </aside>

      <section class="ex-stage" id="ex-stage" aria-label="Visor">
        <div id="ex-pano" class="ex-layer"></div>
        <div id="ex-model" class="ex-layer" hidden></div>
        <div id="ex-img" class="ex-layer" hidden><img alt="" /></div>
        <div id="ex-casa" class="ex-layer" hidden>
          <div class="ex-casa-canvas"></div>
          <div class="ex-casa-labels" aria-hidden="true"></div>
          <div class="ex-casa-side">
            <div class="ex-legend" id="ex-legend"></div>
            <div class="ex-casa-cuerpos" role="group" aria-label="Filtrar por cuerpo"></div>
          </div>
          <div class="ex-pisos" role="group" aria-label="Elegir piso"></div>
          <div class="ex-tip" role="status" hidden></div>
        </div>
        <div id="ex-video" class="ex-layer" hidden><video muted loop playsinline controls preload="none" poster="/explorar/video/sobrevuelo_poster.jpg"></video></div>
        <span class="ex-label" id="ex-label"></span>
        <span class="ex-badge" id="ex-badge"></span>
        <div class="ex-chips" id="ex-chips"></div>
        <span class="ex-hint" id="ex-hint"></span>
        <div class="ex-loading" id="ex-loading" hidden></div>
        <div class="ex-mini" id="ex-mini" hidden>
          <div class="ex-mini-head">
            <span id="ex-mini-title">Planta</span>
            <button type="button" id="ex-mini-min" aria-expanded="true" title="Minimizar">–</button>
            <button type="button" id="ex-mini-close" title="Cerrar">×</button>
          </div>
          <div class="ex-mini-body">
            <img alt="" />
            <span class="ex-cone" hidden></span>
            <span class="ex-dot" hidden></span>
          </div>
        </div>
        <div class="ex-ctrl">
          <button type="button" class="ex-cot ex-ui-only" id="ex-cot" hidden>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            <span>Cotizar<span class="ex-cot-x" id="ex-cot-txt"> esta tipología</span></span>
          </button>
          <button type="button" class="ex-round ex-ui-only" id="ex-planta" title="Ver planta" aria-pressed="false" hidden>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3.5" y="3.5" width="17" height="17"/><path d="M3.5 12h7v8.5M14 3.5v6h6.5"/></svg>
          </button>
          <button type="button" class="ex-round" id="ex-ui" title="Ocultar controles" aria-pressed="false">
            <svg class="ex-eye-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="ex-eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="3"/><path d="M4 20L20 4"/></svg>
          </button>
          <a class="ex-round ex-ui-only" id="ex-open" href="#" target="_blank" rel="noopener" title="Abrir imagen en tamaño completo" hidden>↗</a>
          <button type="button" class="ex-round ex-ui-only" id="ex-home" title="Volver a la vista inicial">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
          </button>
          <button type="button" class="ex-round" id="ex-fs" title="Pantalla completa">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
          </button>
        </div>
      </section>
    </div>
  </main>

  <dialog id="sel-dialog" class="ex-dialog">
    <form method="dialog" class="ex-dialog-close"><button aria-label="Cerrar">×</button></form>
    <p class="ex-eyebrow">Mi selección</p>
    <h2 class="ex-dialog-title">Unidades que te interesan</h2>
    <div id="sel-list"></div>
    <a id="sel-cta" class="btn btn-dark" href="/contacto" data-track="explorar_cotizar_seleccion">Solicitar cotización</a>
    <p class="ex-small">Tu selección se guarda solo en este navegador.</p>
  </dialog>

  <dialog id="cot-dialog" class="ex-dialog">
    <form method="dialog" class="ex-dialog-close"><button aria-label="Cerrar">×</button></form>
    <p class="ex-eyebrow">Cotizar desde el 360°</p>
    <h2 class="ex-dialog-title" id="cot-title">Esta tipología</h2>
    <p class="ex-note" id="cot-note"></p>
    <div id="cot-list"></div>
    <a id="cot-cta" class="btn btn-dark" href="/contacto" data-track="explorar_cotizar_360_contacto">Solicitar cotización</a>
    <p class="ex-small">Lo que agregues queda en «Mi selección», guardada solo en este navegador.</p>
  </dialog>

  <dialog id="about-dialog" class="ex-dialog">
    <form method="dialog" class="ex-dialog-close"><button aria-label="Cerrar">×</button></form>
    <p class="ex-eyebrow">Sobre esta versión</p>
    <h2 class="ex-dialog-title">Qué estás viendo</h2>
    <ul class="ex-about">
      <li><b>Recorridos e imágenes.</b> Renderizados en Blender (Cycles) desde las escenas de revisión del proyecto. La luz del sol de cada departamento sigue la orientación de su fachada principal según el cuadro de superficies (con sol de invierno en las orientaciones norte); decoración y vegetación son de presentación.</li>
      <li><b>Interiores.</b> Hay un interior modelado por cada planta tipo (una unidad representante por cada una de las 11 familias, incluida la 1D de la Casona, 201 A), con un estándar de terminaciones común de presentación: no corresponde a una especificación de venta ni se replica unidad por unidad. Cada recorrido incluye estar, dormitorio y, según la unidad, cocina, baño y acceso; puedes pasar de un ambiente a otro con los puntos de navegación. Las terrazas están modeladas según las láminas de cada planta (304 B, 305 B, 304 C, 501 B y 308 B); su mobiliario es una propuesta de ambientación.</li>
      <li><b>Locales.</b> Se muestran ambientados como una propuesta gastronómica, solo como referencia de uso. Se entregan sin habilitar. Las figuras humanas son siluetas neutras de maqueta, para dar escala y sentido de uso. Su perímetro se tomó de plantas de contexto y la altura libre (3,0 m) es supuesta.</li>
      <li><b>Plantas 3D.</b> Vistas cenitales e isométricas amobladas, renderizadas del mismo interior de presentación. Están disponibles en las tipologías y locales que ya tienen interior; el mobiliario es referencial.</li>
      <li><b>Plantas.</b> Recortes de la planimetría de arquitectura vigente. Cada tipología muestra a una unidad representante; otras unidades de la misma familia pueden tener variantes menores. Algunas plantas se muestran con su contexto y no reemplazan los planos de venta.</li>
      {hayRecorridoEdificio && (
        <li><b>Recorrido desde Santo Domingo.</b> Un recorrido por el acceso y los espacios comunes del edificio, con un plano de ubicación para orientarse.</li>
      )}
      <li><b>Acceso por Santo Domingo.</b> Las imágenes del portón, el zaguán en doble altura, la galería hacia la conserjería y el hall del ascensor salen del modelo del conjunto y de las láminas de abril. El video «De la calle al depto» sigue ese mismo camino y, tras un fundido, entra al 304 B: el pasillo de los pisos superiores aún no está modelado en detalle, por eso no se muestra. Las puertas abiertas, la cabina y las puertas del ascensor (en la cara que indica la planta) y la iluminación son de presentación.</li>
      <li><b>Unidades 3D.</b> Volumen de cada unidad, piso por piso, trazado desde la planimetría de arquitectura. El color indica la disponibilidad real según la lista de precios vigente (la misma de <a href="/disponibilidad">Disponibilidad</a>).</li>
      <li><b>Superficies y precios.</b> Los mismos de <a href="/disponibilidad">Disponibilidad</a>: superficie total = útil + terraza. Precios de lista referenciales en UF.</li>
      <li><b>Pendiente.</b> Los patios de luz aún no tienen ambientación: el volumen del conjunto todavía no trae sus fachadas interiores. La volumetría general del conjunto (modelo 3D, sobrevuelo y vistas aéreas) sigue en revisión frente a los planos definitivos.</li>
    </ul>
    <p class="ex-small">Imágenes referenciales. El proyecto puede presentar modificaciones.</p>
  </dialog>

  <Footer variant="simple" />

  <script type="application/json" id="explorar-data" set:html={JSON.stringify(payload)} />
</BaseLayout>

<style is:global>
  .ex { --ex-bar-h: 104px; --ex-panel-w: 420px; background: var(--c-bg); }
  .ex-bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 0 var(--pad-x-header); height: var(--ex-bar-h); border-bottom: 1px solid var(--c-line); }
  .ex-eyebrow { margin: 0 0 6px; font-size: 11px; font-weight: 600; letter-spacing: 2.4px; text-transform: uppercase; color: var(--c-eyebrow); }
  .ex-h1 { margin: 0; font-family: var(--font-serif); font-weight: 300; font-size: 30px; line-height: 1.1; }
  .ex-bar-actions { display: flex; gap: 28px; align-items: center; }
  .ex-link { background: none; border: 0; padding: 6px 0; font: inherit; font-size: 14px; color: var(--c-text-2); cursor: pointer; display: inline-flex; align-items: center; gap: 10px; }
  .ex-link:hover { color: var(--c-text); }
  .ex-count { display: inline-grid; place-items: center; min-width: 24px; height: 24px; padding: 0 6px; border-radius: 12px; background: var(--c-dark); color: #fff; font-size: 12px; font-weight: 600; }

  .ex-body { display: flex; height: calc(100vh - var(--header-h) - var(--ex-bar-h)); min-height: 600px; }
  .ex-panel { width: var(--ex-panel-w); flex: none; overflow-y: auto; padding: 28px 32px 24px; border-right: 1px solid var(--c-line); background: var(--c-bg); }
  .ex-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 6px; background: var(--c-surface); }
  .ex-tab { border: 0; background: none; padding: 11px 4px; font: inherit; font-size: 13px; color: var(--c-muted); cursor: pointer; }
  .ex-tab:hover { color: var(--c-text); }
  .ex-tab[aria-selected='true'] { background: var(--c-dark); color: #fff; }

  .ex-h2 { margin: 28px 0 14px; font-size: 11px; font-weight: 600; letter-spacing: 2.4px; text-transform: uppercase; color: var(--c-eyebrow); }
  .ex-list { display: flex; flex-direction: column; gap: 10px; }
  .ex-item { display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; padding: 10px; background: #fff; border: 1px solid var(--c-line); font: inherit; color: inherit; cursor: pointer; transition: border-color .2s, background-color .2s; }
  .ex-item:hover { border-color: var(--c-line-strong); }
  .ex-item[aria-current='true'] { background: var(--c-surface); border-color: var(--c-stone); }
  .ex-item img { width: 84px; height: 68px; object-fit: cover; flex: none; background: var(--c-surface); }
  .ex-item .plan { object-fit: contain; background: #fff; }
  .ex-item b { display: block; font-family: var(--font-serif); font-weight: 400; font-size: 20px; line-height: 1.15; }
  .ex-item small { display: block; margin-top: 4px; font-size: 10.5px; letter-spacing: 1px; text-transform: uppercase; color: var(--c-muted); }
  .ex-item .tag { margin-left: auto; align-self: flex-start; font-size: 10px; letter-spacing: 1px; text-transform: uppercase; padding: 3px 7px; background: var(--c-chip); color: var(--c-chip-ink); white-space: nowrap; }

  .ex-row { display: grid; grid-template-columns: 64px 1fr auto; align-items: center; gap: 10px; width: 100%; padding: 11px 12px; border: 0; border-bottom: 1px solid var(--c-line-soft); background: none; font: inherit; font-size: 13px; color: inherit; text-align: left; cursor: pointer; }
  .ex-row:hover { background: var(--c-surface); }
  .ex-row[aria-current='true'] { background: var(--c-selection); }
  .ex-row b { font-family: var(--font-serif); font-weight: 400; font-size: 18px; }
  .ex-row span { color: var(--c-muted); }
  .ex-row em { font-style: normal; font-variant-numeric: tabular-nums; }

  .ex-filters { display: flex; gap: 8px; flex-wrap: wrap; margin: 20px 0 12px; }
  .ex-search { width: 100%; padding: 11px 12px; border: 1px solid var(--c-line); font: inherit; font-size: 14px; margin-top: 20px; background: #fff; }
  .ex-chip { border: 1px solid var(--c-line); background: #fff; padding: 7px 13px; font: inherit; font-size: 12.5px; cursor: pointer; color: var(--c-text-2); }
  .ex-chip[aria-pressed='true'] { background: var(--c-dark); color: #fff; border-color: var(--c-dark); }

  .ex-card { margin-top: 22px; padding: 20px; background: var(--c-surface); }
  .ex-card h3 { margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: 26px; }
  .ex-card .sub { margin: 4px 0 14px; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; color: var(--c-muted); }
  .ex-dl { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; margin: 0 0 16px; }
  .ex-dl dt { font-size: 10.5px; letter-spacing: 1px; text-transform: uppercase; color: var(--c-muted); }
  .ex-dl dd { margin: 2px 0 0; font-size: 15px; }
  .ex-units { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 16px; }
  .ex-units button { border: 1px solid var(--c-line-strong); background: #fff; padding: 4px 8px; font: inherit; font-size: 12px; cursor: pointer; }
  .ex-units button:hover { background: var(--c-dark); color: #fff; }
  .ex-actions { display: flex; flex-direction: column; gap: 8px; }
  .ex-actions .btn { width: 100%; padding: 13px 18px; font-size: 12px; }
  .ex-actions .btn-line { background: #fff; color: var(--c-text); border: 1px solid var(--c-line-strong); }
  .ex-actions .btn-line:hover { border-color: var(--c-dark); }
  .ex-note { font-size: 13px; line-height: 1.6; color: var(--c-muted); margin: 0 0 16px; }
  .ex-foot { margin: 24px 0 0; font-size: 11px; line-height: 1.55; color: var(--c-eyebrow); }
  .ex-empty { padding: 20px 0; font-size: 13px; color: var(--c-muted); }

  .ex-stage { position: relative; flex: 1; min-width: 0; background: #121212; overflow: hidden; }
  .ex-layer { position: absolute; inset: 0; }
  .ex-layer[hidden] { display: none !important; }
  #ex-video { display: flex; align-items: center; justify-content: center; background: #000; }
  #ex-video video { display: block; max-width: 100%; max-height: 100%; width: 100%; height: auto; object-fit: contain; }
  #ex-img { display: flex; align-items: center; justify-content: center; }
  #ex-img img { display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  #ex-img.is-plan { background: #fff; padding: 64px 32px 96px; }
  #ex-img.is-plan img { cursor: zoom-in; }
  #ex-model model-viewer { width: 100%; height: 100%; background: linear-gradient(#f3f0eb, #dcd6cd); --poster-color: transparent; }
  .ex-label { position: absolute; top: 28px; left: 32px; z-index: 5; color: #fff; font-size: 11.5px; font-weight: 500; letter-spacing: 3.2px; text-transform: uppercase; text-shadow: 0 1px 6px rgb(0 0 0 / .45); pointer-events: none; }
  .ex-stage.on-light .ex-label { color: var(--c-text); text-shadow: none; }
  .ex-badge { position: absolute; top: 22px; right: 20px; z-index: 5; max-width: 46%; padding: 8px 14px; background: rgb(255 255 255 / .94); font-size: 11.5px; color: var(--c-text-2); }
  .ex-badge:empty, .ex-hint:empty { display: none; }
  .ex-chips { position: absolute; left: 50%; bottom: 76px; transform: translateX(-50%); z-index: 5; display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; width: max-content; max-width: calc(100% - 200px); }
  .ex-chips button { border: 0; padding: 12px 24px; background: #fff; font: inherit; font-size: 14px; cursor: pointer; box-shadow: 0 2px 10px rgb(0 0 0 / .12); }
  .ex-chips button[aria-pressed='true'] { background: var(--c-dark); color: #fff; }
  .ex-hint { position: absolute; left: 32px; bottom: 26px; z-index: 5; padding: 9px 18px; background: rgb(255 255 255 / .92); font-size: 10.5px; letter-spacing: 2.6px; text-transform: uppercase; pointer-events: none; }
  .ex-loading { position: absolute; inset: 0; z-index: 4; display: grid; place-items: center; color: #fff; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; background: rgb(18 18 18 / .55); pointer-events: none; }
  .ex-loading[hidden] { display: none; }
  .ex-ctrl { position: absolute; right: 20px; bottom: 20px; z-index: 5; display: flex; gap: 10px; }
  .ex-round { width: 46px; height: 46px; border-radius: 50%; border: 0; display: grid; place-items: center; background: rgb(255 255 255 / .94); color: var(--c-text); cursor: pointer; font-size: 18px; box-shadow: 0 2px 10px rgb(0 0 0 / .12); }
  .ex-round[hidden] { display: none; }
  .ex-stage .pnlm-container { background: #121212; }
  .ex-stage .pnlm-load-box { background: rgb(0 0 0 / .55); border-radius: 0; }

  /* Saltos entre vistas (hotspots de Pannellum): el div mide lo que el círculo, el rótulo cuelga debajo. */
  .ex-stage .ex-hs { width: 44px; height: 44px; cursor: pointer; }
  .ex-hs-dot { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid rgb(255 255 255 / .9); background: rgb(20 20 20 / .32); color: #fff; backdrop-filter: blur(2px); transition: background-color .2s, transform .2s; }
  .ex-hs:hover .ex-hs-dot { background: rgb(20 20 20 / .55); transform: scale(1.08); }
  .ex-hs-txt { position: absolute; top: 50px; left: 50%; transform: translateX(-50%); white-space: nowrap; padding: 4px 9px; background: rgb(20 20 20 / .55); color: #fff; font-size: 10.5px; letter-spacing: 1.6px; text-transform: uppercase; pointer-events: none; }

  /* Ocultar controles */
  .ex-stage.ui-off :is(.ex-label, .ex-badge, .ex-chips, .ex-hint, .ex-mini, .ex-ui-only, .ex-hs, .ex-casa-side, .ex-pisos, .ex-casa-labels) { display: none !important; }
  #ex-ui .ex-eye-off, #ex-ui[aria-pressed='true'] .ex-eye-on { display: none; }
  #ex-ui[aria-pressed='true'] .ex-eye-off { display: block; }
  .ex-round[aria-pressed='true']:not(#ex-ui) { background: var(--c-dark); color: #fff; }

  /* Recuadro de planta */
  .ex-mini { position: absolute; left: 32px; top: 64px; z-index: 6; width: 260px; background: rgb(255 255 255 / .96); box-shadow: 0 4px 18px rgb(0 0 0 / .18); }
  .ex-mini[hidden] { display: none; }
  .ex-mini-head { display: flex; align-items: center; gap: 4px; padding: 6px 6px 6px 12px; font-size: 10.5px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--c-text-2); }
  .ex-mini-head span { flex: 1; }
  .ex-mini-head button { width: 28px; height: 28px; border: 0; background: none; font: inherit; font-size: 17px; line-height: 1; color: var(--c-muted); cursor: pointer; }
  .ex-mini-head button:hover { color: var(--c-text); }
  .ex-mini.is-min .ex-mini-body { display: none; }
  .ex-mini-body { position: relative; line-height: 0; overflow: hidden; }
  .ex-mini-body img { display: block; width: 100%; height: auto; }
  .ex-dot { position: absolute; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; background: #b5532e; box-shadow: 0 0 0 2px #fff; }
  .ex-dot::after { content: ''; position: absolute; inset: -2px; border-radius: 50%; border: 2px solid #b5532e; animation: ex-pulso 1.8s ease-out infinite; }
  @keyframes ex-pulso { from { transform: scale(1); opacity: .9; } to { transform: scale(3.2); opacity: 0; } }
  .ex-cone { position: absolute; width: 90px; height: 90px; margin: -45px 0 0 -45px; border-radius: 50%; pointer-events: none;
    background: conic-gradient(from calc(var(--rumbo, 0deg) - var(--abre, 50deg)), rgb(181 83 46 / .38) 0deg calc(var(--abre, 50deg) * 2), transparent 0);
    -webkit-mask: radial-gradient(closest-side, #000 55%, transparent); mask: radial-gradient(closest-side, #000 55%, transparent); }
  .ex-dot[hidden], .ex-cone[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { .ex-dot::after { animation: none; } }

  /* Unidades 3D (casa de muñecas) */
  #ex-casa { background: linear-gradient(#f5f2ed, #e2ddd5); touch-action: none; -webkit-tap-highlight-color: transparent; }
  .ex-casa-canvas, .ex-casa-canvas canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .ex-casa-labels { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .ex-casa-labels span { position: absolute; left: 0; top: 0; white-space: nowrap; font-size: 10.5px; letter-spacing: 2.4px; text-transform: uppercase; color: var(--c-text-2); padding: 3px 8px; background: rgb(255 255 255 / .7); }
  .ex-casa-side { position: absolute; left: 32px; top: 64px; z-index: 5; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .ex-legend { display: flex; flex-direction: column; gap: 6px; padding: 10px 12px; background: rgb(255 255 255 / .9); font-size: 12px; color: var(--c-text-2); }
  .ex-legend span { display: flex; align-items: center; gap: 8px; }
  .ex-legend i { width: 12px; height: 12px; flex: none; }
  .ex-casa-cuerpos { display: flex; gap: 4px; }
  .ex-casa-cuerpos button, .ex-pisos button { border: 0; background: rgb(255 255 255 / .94); font: inherit; font-size: 12.5px; color: var(--c-text-2); cursor: pointer; box-shadow: 0 1px 6px rgb(0 0 0 / .1); }
  .ex-casa-cuerpos button { padding: 6px 10px; }
  .ex-pisos { position: absolute; right: 20px; top: 50%; transform: translateY(-50%); z-index: 5; display: flex; flex-direction: column; gap: 6px; }
  .ex-pisos button { min-width: 52px; height: 34px; padding: 0 10px; font-variant-numeric: tabular-nums; }
  .ex-casa-cuerpos button[aria-pressed='true'], .ex-pisos button[aria-pressed='true'] { background: var(--c-dark); color: #fff; }
  .ex-tip { position: absolute; z-index: 7; left: 0; top: 0; min-width: 170px; padding: 10px 12px; background: #fff; box-shadow: 0 4px 16px rgb(0 0 0 / .18); font-size: 12px; line-height: 1.5; color: var(--c-text-2); pointer-events: none; }
  .ex-tip[hidden] { display: none; }
  .ex-tip b { display: block; font-family: var(--font-serif); font-weight: 400; font-size: 19px; color: var(--c-text); }
  .ex-tip em { font-style: normal; font-size: 11px; color: var(--c-muted); }

  .ex-dialog { border: 0; padding: 40px; width: min(560px, calc(100vw - 32px)); max-height: calc(100vh - 64px); color: var(--c-text); }
  .ex-dialog::backdrop { background: rgb(20 20 20 / .55); }
  .ex-dialog-close { position: absolute; top: 12px; right: 16px; }
  .ex-dialog-close button { border: 0; background: none; font-size: 28px; cursor: pointer; color: var(--c-muted); }
  .ex-dialog-title { margin: 0 0 20px; font-family: var(--font-serif); font-weight: 300; font-size: 30px; }
  .ex-about { padding-left: 18px; margin: 0 0 16px; font-size: 14px; line-height: 1.6; color: var(--c-text-2); }
  .ex-about li { margin-bottom: 10px; }
  .ex-small { font-size: 12px; color: var(--c-muted); margin: 14px 0 0; }
  .ex-sel-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--c-line); font-size: 14px; }
  .ex-sel-row b { font-family: var(--font-serif); font-weight: 400; font-size: 20px; min-width: 80px; }
  .ex-sel-row span { color: var(--c-muted); flex: 1; }
  .ex-sel-row button { border: 0; background: none; color: var(--c-muted); cursor: pointer; font-size: 13px; text-decoration: underline; }
  #sel-cta, #cot-cta { margin-top: 22px; width: 100%; }
  #sel-cta[aria-disabled='true'], #cot-cta[aria-disabled='true'] { opacity: .4; pointer-events: none; }
  .ex-sel-row button[aria-pressed='true'] { color: var(--c-text); text-decoration: none; font-weight: 600; }

  /* Cotizar desde el 360° */
  .ex-cot { display: inline-flex; align-items: center; gap: 8px; height: 46px; padding: 0 20px; border: 0; border-radius: 23px; background: var(--c-dark); color: #fff; font: inherit; font-size: 13px; font-weight: 500; letter-spacing: .4px; cursor: pointer; box-shadow: 0 2px 10px rgb(0 0 0 / .18); white-space: nowrap; }
  .ex-cot:hover { background: #000; }
  .ex-cot[hidden] { display: none; }
  /* En escritorio la instrucción de arrastre choca con el botón: el botón manda. */
  .ex-stage.has-cot .ex-hint { display: none; }

  @media (max-width: 1100px) {
    .ex { --ex-panel-w: 360px; }
  }
  @media (max-width: 860px) {
    .ex { --ex-bar-h: auto; }
    .ex-bar { padding: 16px var(--pad-x-header); flex-wrap: wrap; gap: 8px; }
    .ex-h1 { font-size: 24px; }
    .ex-body { flex-direction: column; height: auto; min-height: 0; }
    .ex-stage { order: -1; height: 62vh; min-height: 360px; flex: none; }
    .ex-panel { width: 100%; border-right: 0; padding: 20px 16px; overflow: visible; }
    .ex-chips { bottom: 64px; max-width: calc(100% - 32px); }
    .ex-chips button { padding: 10px 16px; font-size: 13px; }
    .ex-label { top: 18px; left: 16px; }
    .ex-badge { top: 44px; left: 16px; right: auto; max-width: calc(100% - 32px); font-size: 11px; }
    .ex-hint { left: 16px; bottom: 20px; }
    .ex-ctrl { right: 12px; bottom: 12px; }
    #ex-img.is-plan { padding: 72px 12px 110px; }
    .ex-dialog { padding: 28px 20px; }
    .ex-mini { left: 12px; top: 84px; width: 46%; max-width: 220px; }
    /* En celular las instrucciones chocan con los botones; los chips van en una fila desplazable. */
    .ex-hint { display: none; }
    .ex-chips { flex-wrap: nowrap; justify-content: safe center; overflow-x: auto; scrollbar-width: none; left: 12px; right: 12px; transform: none; width: auto; max-width: none; padding: 4px 2px 8px; }
    .ex-chips::-webkit-scrollbar { display: none; }
    .ex-chips button { flex: none; }
    .ex-ctrl { gap: 8px; }
    .ex-round { width: 40px; height: 40px; }
    .ex-cot { height: 40px; padding: 0 14px; font-size: 12.5px; }
    .ex-cot-x { display: none; }
    .ex-casa-side { left: 12px; top: 44px; gap: 6px; }
    .ex-legend { flex-direction: row; flex-wrap: wrap; gap: 4px 10px; padding: 6px 8px; font-size: 11px; max-width: calc(100vw - 90px); }
    .ex-pisos { right: 10px; gap: 4px; }
    .ex-pisos button { min-width: 44px; height: 30px; font-size: 12px; }
    .ex-hs-txt { font-size: 9.5px; }
  }
</style>

<script>
  import type { ExplorarPayload } from '../lib/explorar';
  import { cotizacion360, hrefCotizacion, type Cotizacion360 } from '../lib/cotizar360';

  type Tab = 'edificio' | 'unidades' | 'tipologias' | 'locales' | 'recorridos' | 'imagenes';
  type Familia = ExplorarPayload['familias'][number];
  type Depto = ExplorarPayload['departamentos'][number];
  type Local = ExplorarPayload['locales'][number];

  const D = JSON.parse(document.getElementById('explorar-data')!.textContent!) as ExplorarPayload;
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const content = $('ex-content');
  const stage = $('ex-stage');
  const track = (event: string, params?: Record<string, unknown>) =>
    (window as unknown as { track?: (e: string, p?: unknown) => void }).track?.(event, params);

  // ---------- formato ----------
  const esc = (s: unknown) =>
    String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const m2f = new Intl.NumberFormat('es-CL', { maximumFractionDigits: 2 });
  const uff = new Intl.NumberFormat('es-CL', { maximumFractionDigits: 0 });
  const m2 = (n: number) => `${m2f.format(n)} m²`;
  const uf = (n: number) => `${uff.format(n)} UF`;
  const rango = (a: number, b: number) => (a === b ? m2(a) : `${m2f.format(a)}–${m2f.format(b)} m²`);

  const familiaPorId = new Map(D.familias.map((f) => [f.id, f]));
  const deptoPorNombre = new Map(D.departamentos.map((u) => [u.nombre, u]));
  const localPorId = new Map(D.locales.map((l) => [l.id, l]));
  const recorridoPorId = new Map(D.recorridos.map((r) => [r.id, r]));
  const imgPorId = new Map(D.imagenes.map((i) => [i.id, i]));
  // Las vistas del conjunto son volumetría de revisión: solo en la pestaña Edificio.
  const galeria = D.imagenes.filter((i) => !i.id.startsWith('conjunto'));

  // ---------- estado ----------
  const state = {
    tab: 'recorridos' as Tab,
    id: '' as string,
    cuerpo: '' as string,
    q: '' as string,
  };

  // ---------- Mi selección ----------
  const SEL_KEY = 'pr-seleccion';
  let seleccion: string[] = [];
  try {
    seleccion = JSON.parse(localStorage.getItem(SEL_KEY) ?? '[]').filter((n: unknown) => typeof n === 'string');
  } catch {
    seleccion = [];
  }
  const datosDe = (nombre: string) =>
    deptoPorNombre.get(nombre) ?? D.locales.find((l) => l.unidad === nombre)?.datos;
  seleccion = seleccion.filter((n) => datosDe(n));

  function guardarSeleccion() {
    try {
      localStorage.setItem(SEL_KEY, JSON.stringify(seleccion));
    } catch {
      /* navegación privada: la selección vive solo en esta pestaña */
    }
    $('sel-count').textContent = String(seleccion.length);
  }
  function toggleSeleccion(nombre: string) {
    const i = seleccion.indexOf(nombre);
    if (i >= 0) seleccion.splice(i, 1);
    else seleccion.push(nombre);
    track(i >= 0 ? 'explorar_quitar' : 'explorar_agregar', { label: nombre });
    guardarSeleccion();
    renderPanel();
  }
  const enSeleccion = (n: string) => seleccion.includes(n);
  const botonSeleccion = (nombre: string) =>
    `<button type="button" class="btn ${enSeleccion(nombre) ? 'btn-line' : 'btn-dark'}" data-sel="${esc(nombre)}">${
      enSeleccion(nombre) ? 'Quitar de mi selección' : 'Agregar a mi selección'
    }</button>`;

  function renderSeleccion() {
    const list = $('sel-list');
    const cta = $<HTMLAnchorElement>('sel-cta');
    if (!seleccion.length) {
      list.innerHTML = '<p class="ex-empty">Aún no agregas unidades. Usa «Agregar a mi selección» en cualquier unidad, tipología o local.</p>';
      cta.setAttribute('aria-disabled', 'true');
      cta.href = '/contacto';
      return;
    }
    list.innerHTML = seleccion
      .map((n) => {
        const u = datosDe(n)!;
        return `<div class="ex-sel-row"><b>${esc(n)}</b><span>${esc(u.tcNombre)} · ${esc(u.piso)} · ${m2(u.m2Total)} · ${uf(u.uf)}</span><button type="button" data-unsel="${esc(n)}">Quitar</button></div>`;
      })
      .join('');
    cta.removeAttribute('aria-disabled');
    cta.href = hrefCotizacion(seleccion);
  }
  $('sel-open').addEventListener('click', () => {
    renderSeleccion();
    $<HTMLDialogElement>('sel-dialog').showModal();
  });
  $('sel-list').addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-unsel]');
    if (!b) return;
    toggleSeleccion(b.dataset.unsel!);
    renderSeleccion();
  });
  $('about-open').addEventListener('click', () => $<HTMLDialogElement>('about-dialog').showModal());

  // ---------- Cotizar desde el 360° ----------
  // Lo que se puede cotizar desde el recorrido en pantalla (ver src/lib/cotizar360.ts).
  let cot: Cotizacion360 | null = null;
  function actualizarCot() {
    const b = $('ex-cot');
    b.hidden = !cot || $('ex-pano').hidden;
    stage.classList.toggle('has-cot', !b.hidden);
    if (!cot) return;
    $('ex-cot-txt').textContent = cot.tipo === 'local' ? ' este local' : ' esta tipología';
    b.setAttribute('aria-label', cot.tipo === 'local' ? `Cotizar ${cot.titulo}` : `Cotizar la tipología ${cot.tc}`);
  }
  function renderCot() {
    if (!cot || cot.tipo !== 'tipologia') return;
    const n = cot.unidades.length;
    $('cot-title').textContent = `Tipología ${cot.tc} · ${cot.tcNombre}`;
    $('cot-note').textContent = `${n === 1 ? 'Queda 1 unidad disponible' : `Quedan ${n} unidades disponibles`} con la planta de este recorrido. Agrega las que te interesen y pide la cotización.`;
    $('cot-list').innerHTML = cot.unidades
      .map((nombre) => {
        const u = deptoPorNombre.get(nombre)!;
        const on = enSeleccion(nombre);
        return `<div class="ex-sel-row"><b>${esc(nombre)}</b><span>${esc(u.piso)} · ${esc(u.orientacion)} · ${m2(u.m2Total)} · ${uf(u.uf)}</span><button type="button" data-cot-sel="${esc(nombre)}" aria-pressed="${on}">${on ? 'Agregada ✓' : 'Agregar'}</button></div>`;
      })
      .join('');
    const cta = $<HTMLAnchorElement>('cot-cta');
    cta.href = hrefCotizacion(seleccion);
    cta.textContent = seleccion.length ? `Solicitar cotización (${seleccion.length})` : 'Solicitar cotización';
    if (seleccion.length) cta.removeAttribute('aria-disabled');
    else cta.setAttribute('aria-disabled', 'true');
  }
  $('ex-cot').addEventListener('click', () => {
    if (!cot) return;
    track('explorar_cotizar_360', { label: state.id, tipo: cot.tipo });
    if (cot.tipo === 'local') {
      if (!enSeleccion(cot.unidad)) toggleSeleccion(cot.unidad);
      renderSeleccion();
      $<HTMLDialogElement>('sel-dialog').showModal();
      return;
    }
    renderCot();
    $<HTMLDialogElement>('cot-dialog').showModal();
  });
  $('cot-list').addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-cot-sel]');
    if (!b) return;
    toggleSeleccion(b.dataset.cotSel!);
    renderCot();
  });

  // ---------- carga diferida de librerías ----------
  const cargados = new Map<string, Promise<void>>();
  function cargar(src: string, tipo: 'script' | 'module' | 'css'): Promise<void> {
    if (!cargados.has(src)) {
      cargados.set(
        src,
        new Promise((ok, err) => {
          const el =
            tipo === 'css'
              ? Object.assign(document.createElement('link'), { rel: 'stylesheet', href: src })
              : Object.assign(document.createElement('script'), { src, type: tipo === 'module' ? 'module' : 'text/javascript' });
          el.onload = () => ok();
          el.onerror = () => err(new Error(`No se pudo cargar ${src}`));
          document.head.appendChild(el);
        })
      );
    }
    return cargados.get(src)!;
  }
  const PANNELLUM = 'https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum';
  const MODEL_VIEWER = 'https://cdn.jsdelivr.net/npm/@google/model-viewer@3.5.0/dist/model-viewer.min.js';
  // three.js como módulo ES: el +esm de jsdelivr reescribe el `import 'three'` de OrbitControls a esta misma URL.
  const THREE_URL = 'https://cdn.jsdelivr.net/npm/three@0.160.0/+esm';
  const ORBIT_URL = 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/controls/OrbitControls.js/+esm';

  // ---------- escenario ----------
  type Vista = ExplorarPayload['recorridos'][number]['vistas'][number];
  type Recorrido = ExplorarPayload['recorridos'][number];
  type PannellumViewer = {
    destroy(): void;
    setYaw(y: number): void;
    setPitch(p: number): void;
    setHfov(h: number): void;
    getYaw(): number;
    getHfov(): number;
    loadScene(id: string, pitch?: number, yaw?: number, hfov?: number): void;
    on(e: string, f: (arg?: unknown) => void): void;
  };
  let pano: PannellumViewer | null = null;
  let panoYaw = 0;
  let modelEl: HTMLElement | null = null;
  let token = 0;
  /** Vistas cargadas en el visor 360 y la que se está mirando. */
  let tour: { vistas: Vista[]; i: number; alCambiar?: (i: number) => void } | null = null;

  const esMovil = () => window.matchMedia('(max-width: 860px)').matches;
  /** Panorama de 2048 px en celulares o con ahorro de datos. */
  const panoDe = (v: Vista) => {
    const ahorro = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    return (esMovil() || ahorro) && v.pano_m ? v.pano_m : v.pano;
  };

  function capas(cual: 'pano' | 'model' | 'img' | 'video' | 'casa') {
    const vid = $('ex-video').querySelector('video')!;
    if (cual !== 'video') vid.pause();
    $('ex-video').hidden = cual !== 'video';
    $('ex-pano').hidden = cual !== 'pano';
    $('ex-model').hidden = cual !== 'model';
    $('ex-img').hidden = cual !== 'img';
    $('ex-casa').hidden = cual !== 'casa';
    if (cual !== 'casa') cerrarCasa();
    if (cual !== 'pano') {
      if (pano) {
        pano.destroy();
        pano = null;
      }
      tour = null;
      actualizarPlanta();
    }
    $('ex-open').hidden = cual !== 'img';
    actualizarCot();
  }

  function rotulos(label: string, badge: string, hint: string, claro = false) {
    $('ex-label').textContent = label;
    $('ex-badge').textContent = badge;
    $('ex-hint').textContent = hint;
    stage.classList.toggle('on-light', claro);
  }

  type Chip = { label: string; on: boolean; go: () => void; key?: string };
  function chips(items: Chip[]) {
    const box = $('ex-chips');
    box.innerHTML = '';
    if (items.length < 2) return;
    items.forEach((it, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = it.label;
      b.dataset.key = it.key ?? String(i);
      b.setAttribute('aria-pressed', String(it.on));
      b.addEventListener('click', () => {
        marcarChip(b.dataset.key!);
        it.go();
      });
      box.appendChild(b);
    });
  }
  function marcarChip(key: string) {
    $('ex-chips')
      .querySelectorAll<HTMLElement>('button')
      .forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.key === key)));
  }

  function cargando(texto: string | null) {
    const el = $('ex-loading');
    el.hidden = texto === null;
    el.textContent = texto ?? '';
  }

  function hotspot(div: HTMLElement, nombre: string) {
    div.innerHTML = `<span class="ex-hs-dot"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 15l6-6 6 6"/></svg></span><span class="ex-hs-txt">${esc(nombre)}</span>`;
    div.title = `Ir a ${nombre}`;
    div.setAttribute('role', 'button');
    div.setAttribute('aria-label', `Ir a ${nombre}`);
  }

  /**
   * Muestra un conjunto de vistas 360° como un recorrido de Pannellum: cada salto es un hotspot y
   * el cambio de vista es un fundido. Si el conjunto ya está cargado, solo cambia de escena.
   */
  async function mostrarVistas(vistas: Vista[], i = 0, alCambiar?: (i: number) => void) {
    if (pano && tour && tour.vistas === vistas) {
      tour.alCambiar = alCambiar;
      if (tour.i !== i) pano.loadScene(String(i));
      return;
    }
    const t = ++token;
    capas('pano');
    tour = { vistas, i, alCambiar };
    panoYaw = vistas[i].yaw;
    actualizarPlanta();
    cargando('Cargando panorama…');
    try {
      await Promise.all([cargar(`${PANNELLUM}.css`, 'css'), cargar(`${PANNELLUM}.js`, 'script')]);
    } catch {
      cargando('No se pudo cargar el visor 360°');
      return;
    }
    if (t !== token) return;
    pano?.destroy();
    const scenes = Object.fromEntries(
      vistas.map((v, k) => [
        String(k),
        {
          type: 'equirectangular',
          panorama: panoDe(v),
          yaw: v.yaw,
          hotSpots: (v.saltos ?? [])
            .filter((s) => s.a !== k && vistas[s.a])
            .map((s) => ({
              type: 'scene',
              sceneId: String(s.a),
              yaw: s.yaw,
              pitch: s.pitch,
              // Los panoramas comparten orientación: se llega mirando hacia donde se caminó.
              targetYaw: 'sameAzimuth',
              cssClass: 'ex-hs',
              createTooltipFunc: hotspot,
              createTooltipArgs: vistas[s.a].nombre,
            })),
        },
      ])
    );
    const P = (window as unknown as { pannellum: { viewer(el: string, cfg: object): PannellumViewer } }).pannellum;
    const v = P.viewer('ex-pano', {
      default: {
        firstScene: String(i),
        sceneFadeDuration: 650,
        autoLoad: true,
        showControls: false,
        showZoomCtrl: false,
        showFullscreenCtrl: false,
        hfov: 100,
        minHfov: 40,
        maxHfov: 120,
        friction: 0.12,
      },
      scenes,
    });
    v.on('load', () => t === token && cargando(null));
    v.on('error', () => t === token && cargando('No se pudo cargar el panorama'));
    v.on('scenechange', (id) => {
      if (t !== token || !tour) return;
      const k = Number(id);
      tour.i = k;
      panoYaw = vistas[k].yaw;
      actualizarPlanta();
      tour.alCambiar?.(k);
    });
    pano = v;
  }

  function mostrarPano(url: string, yaw = 0) {
    return mostrarVistas([{ nombre: '', pano: url, yaw }]);
  }

  // ---------- planta flotante dentro del 360 ----------
  const mini = $('ex-mini');
  const miniImg = mini.querySelector('img')!;
  const miniDot = mini.querySelector<HTMLElement>('.ex-dot')!;
  const miniCono = mini.querySelector<HTMLElement>('.ex-cone')!;
  let plantaAbierta = false;
  const plantaFallida = new Set<string>();
  let conoRaf = 0;
  /** Diferencia entre el yaw de Pannellum y el rumbo en la imagen (grados, horario desde arriba). */
  let conoDesfase: number | null = null;

  const ubicacionDe = (v: Vista) => v.planta ?? v.mapa ?? null;
  const dentro = (u: { x: number; y: number }) => u.x >= 0 && u.x <= 1 && u.y >= 0 && u.y <= 1;

  /**
   * El rumbo de la mirada no viene en los datos, pero se deduce de los saltos: el yaw de un salto
   * apunta a la posición de la otra vista, que está en la misma imagen.
   */
  function calibrarCono(): number | null {
    if (!tour || !miniImg.naturalWidth) return null;
    const W = miniImg.naturalWidth;
    const H = miniImg.naturalHeight;
    for (const v of tour.vistas) {
      const a = ubicacionDe(v);
      if (!a || a.img !== miniImg.getAttribute('src') || !dentro(a)) continue;
      for (const s of v.saltos ?? []) {
        const b = tour.vistas[s.a] && ubicacionDe(tour.vistas[s.a]);
        if (!b || b.img !== a.img || !dentro(b)) continue;
        const dx = (b.x - a.x) * W;
        const dy = (b.y - a.y) * H;
        if (Math.hypot(dx, dy) < 4) continue;
        return (Math.atan2(dx, -dy) * 180) / Math.PI - s.yaw;
      }
    }
    return null;
  }

  function pararCono() {
    cancelAnimationFrame(conoRaf);
    conoRaf = 0;
  }
  function animarCono() {
    pararCono();
    if (conoDesfase === null || miniCono.hidden) return;
    const paso = () => {
      if (pano && conoDesfase !== null) {
        miniCono.style.setProperty('--rumbo', `${pano.getYaw() + conoDesfase}deg`);
        miniCono.style.setProperty('--abre', `${pano.getHfov() / 2}deg`);
      }
      conoRaf = requestAnimationFrame(paso);
    };
    paso();
  }

  function actualizarPlanta() {
    const v = tour ? tour.vistas[tour.i] : null;
    const u = v ? ubicacionDe(v) : null;
    const btn = $('ex-planta');
    btn.hidden = !u || plantaFallida.has(u.img);
    btn.title = v?.planta ? 'Ver planta' : 'Ver ubicación';
    btn.setAttribute('aria-pressed', String(plantaAbierta && !btn.hidden));
    mini.hidden = btn.hidden || !plantaAbierta;
    if (mini.hidden || !u || !v) return pararCono();
    $('ex-mini-title').textContent = v.planta ? 'Planta' : 'Ubicación';
    const cambio = miniImg.getAttribute('src') !== u.img;
    if (cambio) {
      miniImg.src = u.img;
      miniImg.alt = v.planta ? 'Planta 3D amoblada' : 'Plano de ubicación';
    }
    const ok = dentro(u);
    miniDot.hidden = !ok;
    for (const el of [miniDot, miniCono]) {
      el.style.left = `${u.x * 100}%`;
      el.style.top = `${u.y * 100}%`;
    }
    const listo = () => {
      conoDesfase = calibrarCono();
      miniCono.hidden = !ok || conoDesfase === null;
      animarCono();
    };
    if (miniImg.complete && miniImg.naturalWidth && !cambio) listo();
    else miniImg.onload = listo;
  }

  miniImg.addEventListener('error', () => {
    const src = miniImg.getAttribute('src');
    if (src) plantaFallida.add(src);
    actualizarPlanta();
  });
  $('ex-planta').addEventListener('click', () => {
    plantaAbierta = !plantaAbierta;
    mini.classList.remove('is-min');
    $('ex-mini-min').setAttribute('aria-expanded', 'true');
    actualizarPlanta();
  });
  $('ex-mini-close').addEventListener('click', () => {
    plantaAbierta = false;
    actualizarPlanta();
  });
  $('ex-mini-min').addEventListener('click', (e) => {
    const min = mini.classList.toggle('is-min');
    (e.currentTarget as HTMLElement).setAttribute('aria-expanded', String(!min));
    (e.currentTarget as HTMLElement).textContent = min ? '+' : '–';
    (e.currentTarget as HTMLElement).title = min ? 'Expandir' : 'Minimizar';
  });
  $('ex-ui').addEventListener('click', (e) => {
    const off = stage.classList.toggle('ui-off');
    const b = e.currentTarget as HTMLElement;
    b.setAttribute('aria-pressed', String(off));
    b.title = off ? 'Mostrar controles' : 'Ocultar controles';
  });

  function mostrarImagen(url: string, alt: string, plano = false) {
    ++token;
    capas('img');
    cargando(null);
    const box = $('ex-img');
    box.classList.toggle('is-plan', plano);
    const img = box.querySelector('img')!;
    img.src = url;
    img.alt = alt;
    $<HTMLAnchorElement>('ex-open').href = url;
  }

  const SOBREVUELO = '/explorar/video/sobrevuelo.mp4';
  const RECORRIDO_ACCESO = '/explorar/video/recorrido_acceso.mp4';
  function mostrarVideo(url: string) {
    ++token;
    capas('video');
    cargando(null);
    const vid = $('ex-video').querySelector('video')!;
    if (!vid.src.endsWith(url)) {
      vid.poster = url.replace(/\.mp4$/, '_poster.jpg');
      vid.src = url;
    }
    vid.play().catch(() => {});
  }

  async function mostrarModelo(url: string, opciones: { orbit?: string; autoRotate?: boolean } = {}) {
    const t = ++token;
    capas('model');
    cargando('Cargando modelo 3D…');
    try {
      await cargar(MODEL_VIEWER, 'module');
      await customElements.whenDefined('model-viewer');
    } catch {
      cargando('No se pudo cargar el visor 3D');
      return;
    }
    if (t !== token) return;
    const box = $('ex-model');
    box.innerHTML = '';
    modelEl = document.createElement('model-viewer');
    const attrs: Record<string, string> = {
      src: url,
      'camera-controls': '',
      'touch-action': 'pan-y',
      'shadow-intensity': '0.8',
      exposure: '0.9',
      'environment-image': 'neutral',
      'interaction-prompt': 'none',
      'camera-orbit': opciones.orbit ?? '35deg 60deg auto',
      'min-camera-orbit': 'auto 0deg auto',
      'max-camera-orbit': 'auto 88deg auto',
      alt: 'Modelo 3D',
    };
    if (opciones.autoRotate) attrs['auto-rotate'] = '';
    Object.entries(attrs).forEach(([k, v]) => modelEl!.setAttribute(k, v));
    modelEl.addEventListener('progress', (e) => {
      const p = (e as CustomEvent<{ totalProgress: number }>).detail.totalProgress;
      if (t !== token) return;
      cargando(p >= 1 ? null : `Cargando modelo 3D… ${Math.round(p * 100)}%`);
    });
    modelEl.addEventListener('error', () => t === token && cargando('No se pudo cargar el modelo'));
    box.appendChild(modelEl);
  }

  // ---------- Unidades 3D (casa de muñecas, three.js) ----------
  type PisoCasa = {
    id: string;
    cuerpo: string;
    nivel: number;
    nombre: string;
    z: number;
    alto: number;
    contorno: [number, number][];
    unidades: { nombre: string; tipo: 'depto' | 'local'; poly: [number, number][]; centro: [number, number] }[];
  };
  type DatosCasa = { fuente: string; pisos: PisoCasa[] };

  const COLOR_ESTADO: Record<string, string> = { disponible: '#aebf9f', reservada: '#e2b25c', vendida: '#bcb8b2' };
  const COLOR_LOCAL = '#d39778';
  const ESTADO_TXT: Record<string, string> = { disponible: 'Disponible', reservada: 'Reservada', vendida: 'Vendida' };
  /** "LOC. 1 B", "1 B" y "1B" son el mismo local; "304 B" y "304B" el mismo depto. */
  const normal = (s: string) => s.toUpperCase().replace(/^LOC\.?/, '').replace(/[\s.]/g, '');
  const deptoPorNormal = new Map(D.departamentos.map((u) => [normal(u.nombre), u]));
  const localPorNormal = new Map(D.locales.map((l) => [normal(l.datos.nombre), l]));

  let casaDatos: Promise<DatosCasa> | null = null;
  let casa: { cerrar(): void; home(): void } | null = null;
  const casaVista = { piso: 'todos', cuerpo: '' };

  function cerrarCasa() {
    casa?.cerrar();
    casa = null;
  }

  async function mostrarCasa() {
    const url = D.modelos.casa_munecas;
    if (!url) return;
    const t = ++token;
    capas('casa');
    cargando('Cargando unidades 3D…');
    casaDatos ??= fetch(url).then((r) => {
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      return r.json();
    });
    let libs: [any, any, DatosCasa];
    try {
      libs = await Promise.all([import(/* @vite-ignore */ THREE_URL), import(/* @vite-ignore */ ORBIT_URL), casaDatos]);
    } catch {
      casaDatos = null;
      if (t === token) cargando('No se pudo cargar el visor 3D');
      return;
    }
    if (t !== token) return;
    try {
      casa = crearCasa(libs[0], libs[1].OrbitControls, libs[2]);
      cargando(null);
    } catch {
      cargando('Este navegador no pudo abrir el visor 3D');
    }
  }

  function crearCasa(THREE: any, OrbitControls: any, datos: DatosCasa) {
    const box = $('ex-casa');
    const host = box.querySelector<HTMLElement>('.ex-casa-canvas')!;
    const labelsBox = box.querySelector<HTMLElement>('.ex-casa-labels')!;
    const tip = box.querySelector<HTMLElement>('.ex-tip')!;
    const pisosBox = box.querySelector<HTMLElement>('.ex-pisos')!;
    const cuerposBox = box.querySelector<HTMLElement>('.ex-casa-cuerpos')!;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    host.appendChild(renderer.domElement);
    const canvas: HTMLCanvasElement = renderer.domElement;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 1, 1500);
    scene.add(new THREE.HemisphereLight(0xffffff, 0xcfc6b8, 2.2));
    const sol = new THREE.DirectionalLight(0xffffff, 1.6);
    sol.position.set(-40, 80, 50);
    scene.add(sol);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.maxPolarAngle = Math.PI * 0.49;
    controls.minDistance = 8;
    controls.maxDistance = 400;
    controls.autoRotateSpeed = 0.5;

    // Coordenadas del plano (x, y en metros, z hacia arriba) → three (x, z, −y).
    const extruir = (poly: [number, number][], alto: number) => {
      const shape = new THREE.Shape(poly.map(([x, y]) => new THREE.Vector2(x, y)));
      const g = new THREE.ExtrudeGeometry(shape, { depth: alto, bevelEnabled: false });
      g.rotateX(-Math.PI / 2);
      return g;
    };

    const raiz = new THREE.Group();
    scene.add(raiz);
    const lineas = new THREE.LineBasicMaterial({ color: 0x6f6a63, transparent: true, opacity: 0.55 });
    type Pieza = { mesh: any; nombre: string; tipo: string; info: string; abrir: (() => void) | null };
    const piezas: Pieza[] = [];
    const grupos: { p: PisoCasa; g: any; mats: any[]; meshes: any[] }[] = [];

    for (const p of datos.pisos) {
      const g = new THREE.Group();
      const mats: any[] = [];
      const meshes: any[] = [];
      if (p.contorno?.length > 2) {
        const mLosa = new THREE.MeshStandardMaterial({ color: 0xc9c5bf, roughness: 0.95, transparent: true });
        const losa = new THREE.Mesh(extruir(p.contorno, 0.12), mLosa);
        losa.position.y = p.z - 0.12;
        g.add(losa);
        mats.push(mLosa);
      }
      for (const u of p.unidades) {
        if (!u.poly || u.poly.length < 3) continue;
        const d = u.tipo === 'local' ? null : deptoPorNormal.get(normal(u.nombre));
        const l = u.tipo === 'local' ? localPorNormal.get(normal(u.nombre)) : null;
        const datosU = d ?? l?.datos;
        const estado = datosU?.estado ?? '';
        const color = l && estado === 'disponible' ? COLOR_LOCAL : COLOR_ESTADO[estado] ?? '#d6d2cc';
        const geo = extruir(u.poly, Math.max(0.3, p.alto - 0.15));
        const mat = new THREE.MeshStandardMaterial({ color, roughness: 0.8, transparent: true });
        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.y = p.z;
        mesh.add(new THREE.LineSegments(new THREE.EdgesGeometry(geo, 25), lineas));
        g.add(mesh);
        mats.push(mat);
        meshes.push(mesh);
        const estadoTxt = ESTADO_TXT[estado] ?? '';
        const info = d
          ? `<b>${esc(d.nombre)}</b>Tipología ${esc(d.tc)} · ${esc(d.tcNombre)}<br>${m2(d.m2Total)} totales · ${esc(estadoTxt)}`
          : l
          ? `<b>${esc(l.titulo)}</b>Local comercial · ${esc(l.datos.piso)}<br>${m2(l.datos.m2Total)} totales · ${esc(estadoTxt)}`
          : `<b>${esc(u.nombre)}</b>`;
        piezas.push({
          mesh,
          nombre: u.nombre,
          tipo: u.tipo,
          info,
          abrir: d ? () => ir('unidades', d.nombre, { scroll: true }) : l ? () => ir('locales', l.id, { scroll: true }) : null,
        });
      }
      raiz.add(g);
      grupos.push({ p, g, mats, meshes });
    }

    // Centrar el conjunto en el origen.
    const caja = new THREE.Box3().setFromObject(raiz);
    const centro = caja.getCenter(new THREE.Vector3());
    raiz.position.set(-centro.x, 0, -centro.z);
    const cajaTotal = new THREE.Box3().setFromObject(raiz);

    // Rótulos "Cuerpo A/B/C" sobre cada cuerpo (en coordenadas de mundo, ya centradas).
    raiz.updateMatrixWorld(true);
    const rotulosCuerpo = [...new Set(datos.pisos.map((p) => p.cuerpo))].sort().map((c) => {
      const b = new THREE.Box3();
      grupos.filter((x) => x.p.cuerpo === c).forEach((x) => b.expandByObject(x.g));
      const pos = b.getCenter(new THREE.Vector3());
      pos.y = b.max.y + 1.5;
      const el = document.createElement('span');
      el.textContent = `Cuerpo ${c}`;
      labelsBox.appendChild(el);
      return { c, pos, el };
    });

    // Leyenda, filtro por cuerpo y selector de piso.
    $('ex-legend').innerHTML =
      Object.entries(ESTADO_TXT)
        .map(([k, txt]) => `<span><i style="background:${COLOR_ESTADO[k]}"></i>${txt}</span>`)
        .join('') + `<span><i style="background:${COLOR_LOCAL}"></i>Local disponible</span>`;
    const niveles = [...new Set(datos.pisos.map((p) => p.nivel))].sort((a, b) => b - a);
    pisosBox.innerHTML = ['todos', ...niveles.map(String)]
      .map(
        (n) =>
          `<button type="button" data-piso="${n}" aria-pressed="${casaVista.piso === n}" title="${n === 'todos' ? 'Ver todo el conjunto' : `Ver el piso ${n}`}">${
            n === 'todos' ? 'Todos' : n.replace('-', '−')
          }</button>`
      )
      .join('');
    cuerposBox.innerHTML = rotulosCuerpo
      .map((r) => `<button type="button" data-ccuerpo="${r.c}" aria-pressed="${casaVista.cuerpo === r.c}" title="Destacar el cuerpo ${r.c}">${r.c}</button>`)
      .join('');

    // Cámara
    const ease = (x: number) => (x < 0.5 ? 2 * x * x : 1 - (-2 * x + 2) ** 2 / 2);
    let anim: { t0: number; dur: number; p0: any; p1: any; q0: any; q1: any } | null = null;
    function volar(pos: any, target: any, inmediato = false) {
      if (inmediato) {
        camera.position.copy(pos);
        controls.target.copy(target);
        anim = null;
        return;
      }
      anim = { t0: performance.now(), dur: 750, p0: camera.position.clone(), p1: pos, q0: controls.target.clone(), q1: target };
    }
    function encuadre(b: any, polar: number, azimut: number) {
      const esfera = b.getBoundingSphere(new THREE.Sphere());
      const vfov = (camera.fov * Math.PI) / 180;
      const hfov = 2 * Math.atan(Math.tan(vfov / 2) * camera.aspect);
      // En vertical el selector de piso tapa el borde derecho: se deja más aire.
      const dist = (esfera.radius / Math.sin(Math.min(vfov, hfov) / 2)) * (camera.aspect < 1 ? 1.2 : 1.02);
      const c = esfera.center;
      const pos = new THREE.Vector3(
        c.x + dist * Math.sin(polar) * Math.sin(azimut),
        c.y + dist * Math.cos(polar),
        c.z + dist * Math.sin(polar) * Math.cos(azimut)
      );
      return { pos, c };
    }
    function aplicar(inmediato = false) {
      const sel = casaVista.piso === 'todos' ? null : Number(casaVista.piso);
      const visibles = new THREE.Box3();
      for (const x of grupos) {
        const arriba = sel !== null && x.p.nivel > sel;
        const otroCuerpo = !!casaVista.cuerpo && x.p.cuerpo !== casaVista.cuerpo;
        x.g.visible = !arriba;
        const op = otroCuerpo ? 0.12 : 1;
        for (const m of x.mats) {
          m.opacity = op;
          m.depthWrite = op === 1;
        }
        x.g.userData.activo = !arriba && !otroCuerpo;
        if (x.g.userData.activo && (sel === null || x.p.nivel === sel)) visibles.expandByObject(x.g);
      }
      rotulosCuerpo.forEach((r) => (r.el.hidden = sel !== null || (!!casaVista.cuerpo && r.c !== casaVista.cuerpo)));
      pisosBox.querySelectorAll<HTMLElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.piso === casaVista.piso)));
      cuerposBox.querySelectorAll<HTMLElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ccuerpo === casaVista.cuerpo)));
      const b = visibles.isEmpty() ? cajaTotal : visibles;
      const az = anim || inmediato ? 0.6 : Math.atan2(camera.position.x - controls.target.x, camera.position.z - controls.target.z);
      const { pos, c } = encuadre(b, sel === null ? 1.0 : 0.62, az);
      controls.autoRotate = sel === null && !casaVista.cuerpo && !interactuado;
      volar(pos, c, inmediato);
      ocultarTip();
    }

    // Selección con mouse o toque
    const ray = new THREE.Raycaster();
    const ndc = new THREE.Vector2();
    let hover: Pieza | null = null;
    let interactuado = false;
    function elegir(ev: PointerEvent): Pieza | null {
      const r = canvas.getBoundingClientRect();
      ndc.set(((ev.clientX - r.left) / r.width) * 2 - 1, -((ev.clientY - r.top) / r.height) * 2 + 1);
      ray.setFromCamera(ndc, camera);
      const activos = piezas.filter((p) => p.mesh.parent?.visible && p.mesh.parent.userData.activo !== false).map((p) => p.mesh);
      const hit = ray.intersectObjects(activos, false)[0];
      return hit ? piezas.find((p) => p.mesh === hit.object) ?? null : null;
    }
    function resaltar(p: Pieza | null) {
      if (hover === p) return;
      for (const x of piezas) {
        const on = !!p && x.nombre === p.nombre && x.tipo === p.tipo;
        x.mesh.material.emissive.setHex(on ? 0x3a2a1a : 0x000000);
      }
      hover = p;
      canvas.style.cursor = p?.abrir ? 'pointer' : '';
    }
    function mostrarTip(p: Pieza, ev: PointerEvent, tactil: boolean) {
      tip.innerHTML = `${p.info}${p.abrir ? `<br><em>${tactil ? 'Toca de nuevo para ver la ficha' : 'Clic para ver la ficha'}</em>` : ''}`;
      tip.hidden = false;
      const r = box.getBoundingClientRect();
      const x = ev.clientX - r.left;
      const y = ev.clientY - r.top;
      const w = tip.offsetWidth;
      const h = tip.offsetHeight;
      tip.style.transform = `translate(${Math.max(8, Math.min(x + 14, r.width - w - 8))}px, ${Math.max(8, y - h - 14 < 8 ? y + 18 : y - h - 14)}px)`;
    }
    function ocultarTip() {
      tip.hidden = true;
      resaltar(null);
    }

    let abajo: { x: number; y: number; t: number } | null = null;
    const onMove = (ev: PointerEvent) => {
      if (ev.pointerType !== 'mouse' || abajo) return;
      const p = elegir(ev);
      resaltar(p);
      if (p) mostrarTip(p, ev, false);
      else tip.hidden = true;
    };
    const onDown = (ev: PointerEvent) => {
      abajo = { x: ev.clientX, y: ev.clientY, t: performance.now() };
    };
    const onUp = (ev: PointerEvent) => {
      const a = abajo;
      abajo = null;
      if (!a || Math.hypot(ev.clientX - a.x, ev.clientY - a.y) > 6 || performance.now() - a.t > 600) return;
      const p = elegir(ev);
      if (!p) return ocultarTip();
      if (ev.pointerType === 'mouse' || hover === p) {
        if (p.abrir) {
          track('explorar_casa_unidad', { label: p.nombre });
          p.abrir();
        }
        return;
      }
      resaltar(p);
      mostrarTip(p, ev, true);
    };
    // En pantallas táctiles el puntero "sale" al levantar el dedo: ahí el tooltip debe quedarse.
    const onLeave = (ev: PointerEvent) => {
      if (ev.pointerType === 'mouse' && !abajo) ocultarTip();
    };
    canvas.addEventListener('pointermove', onMove);
    canvas.addEventListener('pointerdown', onDown);
    canvas.addEventListener('pointerup', onUp);
    canvas.addEventListener('pointerleave', onLeave);
    controls.addEventListener('start', () => {
      interactuado = true;
      controls.autoRotate = false;
      anim = null;
    });

    const onPisos = (e: Event) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-piso]');
      if (!b) return;
      casaVista.piso = b.dataset.piso!;
      aplicar();
    };
    const onCuerpos = (e: Event) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-ccuerpo]');
      if (!b) return;
      casaVista.cuerpo = casaVista.cuerpo === b.dataset.ccuerpo ? '' : b.dataset.ccuerpo!;
      aplicar();
    };
    pisosBox.addEventListener('click', onPisos);
    cuerposBox.addEventListener('click', onCuerpos);

    // Tamaño y ciclo de dibujo
    let enMarcha = true;
    const tam = () => {
      const w = box.clientWidth;
      const h = box.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };
    const ro = new ResizeObserver(tam);
    ro.observe(box);
    tam();
    aplicar(true);

    const v = new THREE.Vector3();
    let raf = 0;
    const dibujar = (now: number) => {
      if (!enMarcha) return;
      if (anim) {
        const k = Math.min(1, (now - anim.t0) / anim.dur);
        const e = ease(k);
        camera.position.lerpVectors(anim.p0, anim.p1, e);
        controls.target.lerpVectors(anim.q0, anim.q1, e);
        if (k >= 1) anim = null;
      }
      controls.update();
      renderer.render(scene, camera);
      const w = box.clientWidth;
      const h = box.clientHeight;
      for (const r of rotulosCuerpo) {
        if (r.el.hidden) continue;
        v.copy(r.pos).project(camera);
        const fuera = v.z > 1 || Math.abs(v.x) > 1.1 || Math.abs(v.y) > 1.1;
        r.el.style.visibility = fuera ? 'hidden' : '';
        r.el.style.transform = `translate(${((v.x + 1) / 2) * w}px, ${((1 - v.y) / 2) * h}px) translate(-50%, -100%)`;
      }
      raf = requestAnimationFrame(dibujar);
    };
    raf = requestAnimationFrame(dibujar);

    return {
      home() {
        casaVista.piso = 'todos';
        casaVista.cuerpo = '';
        interactuado = false;
        aplicar();
      },
      cerrar() {
        enMarcha = false;
        cancelAnimationFrame(raf);
        ro.disconnect();
        controls.dispose();
        pisosBox.removeEventListener('click', onPisos);
        cuerposBox.removeEventListener('click', onCuerpos);
        scene.traverse((o: any) => {
          o.geometry?.dispose();
          if (o.material) (Array.isArray(o.material) ? o.material : [o.material]).forEach((m: any) => m.dispose());
        });
        renderer.dispose();
        renderer.forceContextLoss();
        canvas.remove();
        labelsBox.innerHTML = '';
        pisosBox.innerHTML = '';
        cuerposBox.innerHTML = '';
        tip.hidden = true;
      },
    };
  }

