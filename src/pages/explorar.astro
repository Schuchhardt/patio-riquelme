  const BADGE_3D = 'Planta 3D amoblada · mobiliario referencial';
  const BADGE_ISO = 'Vista isométrica amoblada · mobiliario referencial';
  type Extra3D = { planta3d: { nombre: string; img: string }[]; iso: string | null };
  /** Chips de la planta 3D y la isométrica, después de los planos CAD. */
  const chips3D = (x: Extra3D, alt: string, label: string): Chip[] => [
    ...x.planta3d.map((p) => ({
      label: x.planta3d.length > 1 ? `3D · ${p.nombre}` : 'Planta 3D',
      key: p.img,
      on: false,
      go: () => {
        rotulos(label, BADGE_3D, '', true);
        mostrarImagen(p.img, `${alt} · planta 3D ${p.nombre}`, true);
      },
    })),
    ...(x.iso
      ? [
          {
            label: 'Isométrica',
            key: x.iso,
            on: false,
            go: () => {
              rotulos(label, BADGE_ISO, '', true);
              mostrarImagen(x.iso!, `${alt} · vista isométrica`, true);
            },
          },
        ]
      : []),
  ];

  function verPlanos(label: string, badge: string, niveles: { nombre: string; plano: string }[], alt: string, extra?: Extra3D) {
    rotulos(label, badge, '', true);
    chips([
      ...niveles.map((n, i) => ({
        label: n.nombre,
        key: n.plano,
        on: i === 0,
        go: () => {
          rotulos(label, badge, '', true);
          mostrarImagen(n.plano, `${alt} · ${n.nombre}`, true);
        },
      })),
      ...(extra ? chips3D(extra, alt, label) : []),
