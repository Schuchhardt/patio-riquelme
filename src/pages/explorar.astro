          </div>`
        : '';
    return `<h2 class="ex-h2">Espacios para descubrir</h2>
      <div class="ex-list">${D.recorridos
        .map((r) => item({ key: 'recorrido', val: r.id, img: r.thumb, titulo: r.nombre, sub: r.tipo, on: r.id === state.id }))
        .join('')}</div>
      ${sel ? `<p class="ex-note" style="margin-top:20px">${esc(sel.nota)}</p>${extra}` : ''}`;
  }

  function panelImagenes() {
    return `<h2 class="ex-h2">Imágenes</h2>
      <div class="ex-list">${galeria
        .map((i) => item({ key: 'imagen', val: i.id, img: i.thumb, titulo: i.nombre, sub: 'Render · Cycles', on: i.id === state.id }))
        .join('')}</div>`;
  }

  const PANELES: Record<Tab, () => string> = {
    edificio: panelEdificio,
    unidades: panelUnidades,
    tipologias: panelTipologias,
    locales: panelLocales,
    recorridos: panelRecorridos,
    imagenes: panelImagenes,
  };

  function renderPanel() {
    const scroll = content.parentElement!.scrollTop;
    const foco = document.activeElement?.id;
    content.innerHTML = PANELES[state.tab]();
    $('ex-foot').textContent = FOOT[state.tab];
    document.querySelectorAll<HTMLElement>('.ex-tab').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === state.tab)));
    content.parentElement!.scrollTop = scroll;
    if (foco === 'ex-q') {
      const q = $<HTMLInputElement>('ex-q');
      q.focus();
      q.setSelectionRange(q.value.length, q.value.length);
    }
  }

  function syncUrl() {
    const p = new URLSearchParams();
    if (state.tab !== 'recorridos') p.set('tab', state.tab);
    if (state.id) p.set('id', state.id);
    const qs = p.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function ir(tab: Tab, id = '', opts: { scroll?: boolean } = {}) {
    state.tab = tab;
    state.id = id;
    cot = null;
    switch (tab) {
      case 'edificio':
        verEdificio(id);
        state.id = '';
        break;
      case 'unidades':
        if (id && deptoPorNombre.has(id)) verUnidad(id);
        else if (!id) verUnidad(D.departamentos.find((u) => u.nombre === '304 B')?.nombre ?? D.departamentos[0].nombre), (state.id = '');
        break;
      case 'tipologias':
        verFamilia(id || D.familias[0].id);
        if (!id) state.id = '';
        break;
      case 'locales':
        verLocal(id || D.locales[0].id);
        if (!id) state.id = '';
        break;
      case 'recorridos':
        verRecorrido(id || '304B');
        break;
      case 'imagenes':
        verImagen(id || galeria[0]?.id);
        break;
    }
    actualizarCot();
    renderPanel();
    syncUrl();
    if (opts.scroll && window.matchMedia('(max-width: 860px)').matches) stage.scrollIntoView({ behavior: 'smooth', block: 'start' });
    track('explorar_ver', { label: `${tab}:${state.id}` });
  }

  document.querySelector('.ex-tabs')!.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-tab]');
    if (b) ir(b.dataset.tab as Tab);
  });

  content.addEventListener('click', (e) => {
    const el = (e.target as Element).closest<HTMLElement>(
      '[data-sel],[data-unidad],[data-familia],[data-local],[data-recorrido],[data-imagen],[data-cuerpo],[data-fcuerpo],[data-go-recorrido],[data-go-familia],[data-modelo],[data-img3d]'
    );
    if (!el) return;
    const d = el.dataset;
    if (d.sel) return toggleSeleccion(d.sel);
    if (d.img3d) return verImagen3D(d.img3d, d.img3dAlt ?? '', d.img3dIso === '1');
    if (d.modelo) {
      const r = recorridoPorId.get(d.modelo);
      if (r) verModeloInterior(r);
      return;
    }
    if (d.goRecorrido) return ir('recorridos', d.goRecorrido, { scroll: true });
    if (d.goFamilia) return ir('tipologias', d.goFamilia, { scroll: true });
    if (d.fcuerpo !== undefined) {
      state.cuerpo = d.fcuerpo;
      return renderPanel();
    }
    if (d.cuerpo) {
      state.cuerpo = d.cuerpo;
      return ir('unidades');
    }
    if (d.unidad) {
      if (localPorId.has(d.unidad)) return ir('locales', d.unidad, { scroll: true });
      return ir('unidades', d.unidad, { scroll: true });
    }
    if (d.familia) return ir('tipologias', d.familia, { scroll: true });
    if (d.local) return ir('locales', d.local, { scroll: true });
    if (d.recorrido) return ir('recorridos', d.recorrido, { scroll: true });
    if (d.imagen) return ir('imagenes', d.imagen, { scroll: true });
  });

  content.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.id !== 'ex-q') return;
    state.q = t.value;
    renderPanel();
  });

  // ---------- arranque ----------
  guardarSeleccion();
  const params = new URLSearchParams(location.search);
  const tabInicial = params.get('tab') as Tab | null;
  ir(tabInicial && tabInicial in PANELES ? tabInicial : 'recorridos', params.get('id') ?? '');
</script>
