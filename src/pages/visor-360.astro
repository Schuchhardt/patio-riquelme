  function fichaFamilia(f: Familia) {
    const r = f.recorrido ? recorridoPorId.get(f.recorrido) : null;
    return `<div class="ex-card">
      <h3>Tipología ${esc(f.tc)}</h3>
      <p class="sub">${esc(f.tcNombre)} · Cuerpo ${esc(f.cuerpo)}</p>
      <dl class="ex-dl">
        <div><dt>Superficie total</dt><dd>${rango(f.m2Min, f.m2Max)}</dd></div>
        <div><dt>Desde</dt><dd>${uf(f.ufMin)}</dd></div>
        <div><dt>Representante</dt><dd>${esc(f.representante)}</dd></div>
        <div><dt>Interior 3D</dt><dd>${r ? 'Disponible' : 'En preparación'}</dd></div>
      </dl>
